---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Layanan Disabilitas - KITA-KTP" description="Perekaman KTP Ramah Disabilitas: Pendampingan sensorik dan layanan jemput bola gratis dengan fitur Audio First.">
  <div x-data="disabilitasAudioFirstPage()" class="w-full max-w-xl mx-auto space-y-6 px-1 sm:px-2">

    <!-- Top Navigation Bar & Master Audio Reader -->
    <div class="flex items-center justify-between gap-2">
      <a
        href="/"
        @click="speakNotice('Kembali ke halaman beranda')"
        class="inline-flex items-center gap-1.5 font-bold text-xs sm:text-sm transition-colors focus:ring-2 rounded-lg px-2 py-1"
        :class="colorFilter === 'high-contrast' ? 'text-[#FACC15] hover:underline' : 'text-slate-600 hover:text-purple-800'"
      >
        <span aria-hidden="true">⬅</span>
        <span>Beranda</span>
      </a>

      <!-- Emergency / Master Audio Banner Button -->
      <button
        type="button"
        @click="readEntireForm()"
        class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black border-2 transition-all inline-flex items-center gap-1.5 cursor-pointer shadow-sm focus:ring-4 shrink-0 active:scale-95"
        :class="[
          isSpeaking
            ? (colorFilter === 'high-contrast' ? 'bg-amber-400 text-black border-amber-300 animate-pulse' : 'bg-red-600 text-white border-red-500 animate-pulse')
            : (colorFilter === 'high-contrast' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300' : 'bg-purple-700 text-white border-purple-800 hover:bg-purple-800')
        ]"
        aria-label="Bacakan seluruh isi formulir ini dengan suara"
      >
        <span aria-hidden="true" class="text-base">🔊</span>
        <span x-text="isSpeaking ? 'Hentikan Suara' : 'Bacakan Seluruh Form Ini'"></span>
      </button>
    </div>

    <!-- Banner Informasi Kontras Tinggi dengan Ikon Visual -->
    <section
      aria-labelledby="disabilitas-banner-title"
      class="rounded-3xl p-5 sm:p-7 border-2 transition-all shadow-md space-y-3"
      :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-purple-300 bg-linear-to-b from-purple-50 via-indigo-50/50 to-white'"
    >
      <div class="flex items-center gap-3.5">
        <div
          class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center text-3xl sm:text-4xl shadow-sm border shrink-0"
          :class="colorFilter === 'high-contrast' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-purple-100 text-purple-900 border-purple-200'"
          aria-hidden="true"
        >
          ♿
        </div>
        <div>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wider border"
            :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-purple-300 bg-purple-100 text-purple-900'"
          >
            Aksesibilitas Penuh (Audio-First)
          </span>
          <h1 id="disabilitas-banner-title" class="text-xl sm:text-2xl font-black tracking-tight mt-1 leading-snug">
            Layanan KTP Inklusif & Pendampingan
          </h1>
        </div>
      </div>

      <div class="p-3.5 rounded-2xl border text-xs sm:text-sm font-bold flex items-start gap-2.5"
        :class="colorFilter === 'high-contrast' ? 'border-[#FACC15]/40 bg-neutral-900 text-[#FACC15]' : 'border-purple-200 bg-purple-100/60 text-purple-950'"
      >
        <span class="text-lg shrink-0" aria-hidden="true">💡</span>
        <p class="leading-relaxed">
          <strong>Fitur Audio Otomatis Aktif:</strong> Setiap kali Anda mengetuk atau memfokuskan kolom input dan opsi layanan di bawah, asisten suara akan membacakan instruksi kolom secara otomatis untuk memudahkan sahabat tuna netra dan disabilitas sensorik.
        </p>
      </div>
    </section>

    <!-- Success Feedback Banner -->
    <div
      x-show="isSuccess"
      x-transition
      role="alert"
      class="rounded-3xl p-6 sm:p-8 border-2 text-center space-y-4 shadow-xl"
      :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-neutral-950 text-[#FACC15]' : 'border-purple-300 bg-purple-50 text-purple-950'"
    >
      <div class="w-16 h-16 mx-auto rounded-full flex items-center justify-center text-3xl font-black"
        :class="colorFilter === 'high-contrast' ? 'bg-[#FACC15] text-black' : 'bg-purple-600 text-white'"
        aria-hidden="true"
      >
        ✓
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl font-black">Permohonan KTP Disabilitas Diterima!</h2>
        <p class="text-sm font-bold mt-1">Tim unit jemput bola beserta pendamping khusus akan segera menghubungi dan mengunjungi kediaman Anda.</p>
      </div>

      <div class="p-4 rounded-2xl border font-mono text-center inline-block"
        :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-purple-300 bg-white text-purple-950 shadow-inner'"
      >
        <span class="block text-xs uppercase font-black">Nomor Registrasi Anda:</span>
        <span class="block text-2xl font-black tracking-widest mt-1" x-text="savedReg"></span>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/lacak"
          class="w-full sm:w-auto px-6 py-3.5 rounded-2xl font-black text-base border transition-all text-center focus:ring-4 cursor-pointer"
          :class="colorFilter === 'high-contrast' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-purple-700 text-white border-purple-700 hover:bg-purple-800 shadow-md'"
        >
          Lihat Status Pengajuan ➔
        </a>
        <button
          type="button"
          @click="isSuccess = false"
          class="w-full sm:w-auto px-4 py-3 rounded-xl font-bold text-xs text-center hover:underline cursor-pointer"
          :class="colorFilter === 'high-contrast' ? 'text-[#FACC15]' : 'text-slate-600'"
        >
          Isi Formulir Baru
        </button>
      </div>
    </div>

    <!-- AUDIO-FIRST ACCESSIBLE FORM -->
    <div
      x-show="!isSuccess"
      class="rounded-3xl p-5 sm:p-7 border-2 transition-all shadow-md"
      :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black' : 'border-slate-300 bg-white'"
    >
      <form @submit.prevent="submitDisabilitas()" class="space-y-5" novalidate>

        <!-- Field 1: NIK (16 Digit) - Bersuara Otomatis saat @focus & @click -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="dis-nik" class="block text-base font-black flex items-center gap-1.5">
              <span>🪪 1. NIK (16 Digit Angka)</span>
              <span class="text-red-500 font-bold" aria-hidden="true">*</span>
            </label>
            <span class="text-xs font-mono font-bold" :class="colorFilter === 'high-contrast' ? 'text-[#FACC15]/80' : 'text-slate-500'" x-text="nik.length + '/16'"></span>
          </div>
          <input
            id="dis-nik"
            type="text"
            inputmode="numeric"
            maxlength="16"
            x-model="nik"
            @focus="speakField('Kolom NIK 16 digit. Masukkan 16 angka yang tertera pada Kartu Keluarga Anda.')"
            @click="speakField('Kolom NIK 16 digit. Masukkan 16 angka yang tertera pada Kartu Keluarga Anda.')"
            @input="nik = nik.replace(/\D/g, '')"
            placeholder="Contoh: 3201012345670001"
            required
            class="w-full px-4 py-3.5 rounded-2xl border-2 font-mono text-base font-bold transition-colors focus:ring-4 focus:outline-none"
            :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-[#FACC15]' : 'border-slate-300 bg-white focus:border-purple-500 focus:ring-purple-300'"
          />
        </div>

        <!-- Field 2: Nama Lengkap - Bersuara Otomatis saat @focus & @click -->
        <div class="space-y-1.5">
          <label for="dis-nama" class="block text-base font-black flex items-center gap-1.5">
            <span>👤 2. Nama Lengkap Pemohon</span>
            <span class="text-red-500 font-bold" aria-hidden="true">*</span>
          </label>
          <input
            id="dis-nama"
            type="text"
            x-model="nama"
            @focus="speakField('Kolom Nama Lengkap Pemohon. Silakan ketik nama lengkap Anda.')"
            @click="speakField('Kolom Nama Lengkap Pemohon. Silakan ketik nama lengkap Anda.')"
            placeholder="Contoh: Budi Santoso"
            required
            class="w-full px-4 py-3.5 rounded-2xl border-2 text-base font-bold transition-colors focus:ring-4 focus:outline-none"
            :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-[#FACC15]' : 'border-slate-300 bg-white focus:border-purple-500 focus:ring-purple-300'"
          />
        </div>

        <!-- Field 3: Pilihan Kebutuhan Khusus / Disabilitas (Radio Bersuara Tiap Klik) -->
        <fieldset class="space-y-2 pt-1">
          <legend class="block text-base font-black flex items-center gap-1.5 mb-1.5">
            <span>♿ 3. Pilihan Ragam Disabilitas</span>
            <span class="text-red-500 font-bold" aria-hidden="true">*</span>
          </legend>

          <div class="space-y-2">
            <!-- Pilihan A: Fisik / Kursi Roda -->
            <label
              class="flex items-center gap-3 p-3 sm:p-3.5 rounded-xl border-2 cursor-pointer font-bold text-xs sm:text-sm transition-all focus-within:ring-4"
              :class="ragam === 'fisik' ? (colorFilter === 'high-contrast' ? 'border-2 border-[#FACC15] bg-neutral-900' : 'border-purple-600 bg-purple-50 ring-2 ring-purple-500/20') : 'border-slate-200 bg-white'"
            >
              <input
                type="radio"
                name="ragam"
                value="fisik"
                x-model="ragam"
                @change="onRagamChange('fisik')"
                class="w-4 h-4 text-purple-600 shrink-0"
              />
              <span class="flex items-center gap-2">
                <span>🦽</span>
                <span>Disabilitas Fisik / Pengguna Kursi Roda</span>
              </span>
            </label>

            <!-- Pilihan B: Sensorik Netra -->
            <label
              class="flex items-center gap-3 p-3 sm:p-3.5 rounded-xl border-2 cursor-pointer font-bold text-xs sm:text-sm transition-all focus-within:ring-4"
              :class="ragam === 'netra' ? (colorFilter === 'high-contrast' ? 'border-2 border-[#FACC15] bg-neutral-900' : 'border-purple-600 bg-purple-50 ring-2 ring-purple-500/20') : 'border-slate-200 bg-white'"
            >
              <input
                type="radio"
                name="ragam"
                value="netra"
                x-model="ragam"
                @change="onRagamChange('netra')"
                class="w-4 h-4 text-purple-600 shrink-0"
              />
              <span class="flex items-center gap-2">
                <span>🦯</span>
                <span>Disabilitas Sensorik Netra (Pendamping Suara)</span>
              </span>
            </label>

            <!-- Pilihan C: Sensorik Rungu / Wicara -->
            <label
              class="flex items-center gap-3 p-3 sm:p-3.5 rounded-xl border-2 cursor-pointer font-bold text-xs sm:text-sm transition-all focus-within:ring-4"
              :class="ragam === 'rungu' ? (colorFilter === 'high-contrast' ? 'border-2 border-[#FACC15] bg-neutral-900' : 'border-purple-600 bg-purple-50 ring-2 ring-purple-500/20') : 'border-slate-200 bg-white'"
            >
              <input
                type="radio"
                name="ragam"
                value="rungu"
                x-model="ragam"
                @change="onRagamChange('rungu')"
                class="w-4 h-4 text-purple-600 shrink-0"
              />
              <span class="flex items-center gap-2">
                <span>🤟</span>
                <span>Disabilitas Sensorik Rungu (Juru Bahasa Isyarat)</span>
              </span>
            </label>

            <!-- Pilihan D: Intelektual & Tirah Baring -->
            <label
              class="flex items-center gap-3 p-3 sm:p-3.5 rounded-xl border-2 cursor-pointer font-bold text-xs sm:text-sm transition-all focus-within:ring-4"
              :class="ragam === 'intelektual' ? (colorFilter === 'high-contrast' ? 'border-2 border-[#FACC15] bg-neutral-900' : 'border-purple-600 bg-purple-50 ring-2 ring-purple-500/20') : 'border-slate-200 bg-white'"
            >
              <input
                type="radio"
                name="ragam"
                value="intelektual"
                x-model="ragam"
                @change="onRagamChange('intelektual')"
                class="w-4 h-4 text-purple-600 shrink-0"
              />
              <span class="flex items-center gap-2">
                <span>🛌</span>
                <span>Disabilitas Intelektual / Kondisi Tirah Baring</span>
              </span>
            </label>
          </div>
        </fieldset>

        <!-- Field 4: Pilihan Metode Layanan (Radio Bersuara Otomatis) -->
        <fieldset class="space-y-1.5 pt-1">
          <legend class="block text-sm font-black flex items-center gap-1.5 mb-1">
            <span>🚐 4. Metode Layanan yang Diinginkan</span>
            <span class="text-red-500 font-bold" aria-hidden="true">*</span>
          </legend>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <label
              class="flex items-center gap-2.5 p-3 rounded-xl border-2 cursor-pointer font-bold text-xs sm:text-sm transition-all focus-within:ring-4"
              :class="layanan === 'jemput_bola' ? (colorFilter === 'high-contrast' ? 'border-2 border-[#FACC15] bg-neutral-900' : 'border-purple-600 bg-purple-50 ring-2 ring-purple-500/20') : 'border-slate-200 bg-white'"
            >
              <input
                type="radio"
                name="layanan"
                value="jemput_bola"
                x-model="layanan"
                @change="onLayananChange('jemput_bola')"
                class="w-4 h-4 text-purple-600 shrink-0"
              />
              <span>Jemput Bola ke Rumah</span>
            </label>

            <label
              class="flex items-center gap-2.5 p-3 rounded-xl border-2 cursor-pointer font-bold text-xs sm:text-sm transition-all focus-within:ring-4"
              :class="layanan === 'kantor' ? (colorFilter === 'high-contrast' ? 'border-2 border-[#FACC15] bg-neutral-900' : 'border-purple-600 bg-purple-50 ring-2 ring-purple-500/20') : 'border-slate-200 bg-white'"
            >
              <input
                type="radio"
                name="layanan"
                value="kantor"
                x-model="layanan"
                @change="onLayananChange('kantor')"
                class="w-4 h-4 text-purple-600 shrink-0"
              />
              <span>Datang ke Kantor Dinas</span>
            </label>
          </div>
        </fieldset>

        <!-- Field 5: Alamat Rumah Penjemputan - Bersuara Otomatis saat @focus & @click -->
        <div class="space-y-1.5">
          <label for="dis-alamat" class="block text-base font-black flex items-center gap-1.5">
            <span>🏠 5. Alamat Rumah Pemohon</span>
            <span class="text-red-500 font-bold" aria-hidden="true">*</span>
          </label>
          <textarea
            id="dis-alamat"
            rows="3"
            x-model="alamat"
            @focus="speakField('Kolom Alamat Rumah Penjemputan. Tuliskan alamat lengkap Anda agar armada petugas mudah menemukan lokasi.')"
            @click="speakField('Kolom Alamat Rumah Penjemputan. Tuliskan alamat lengkap Anda agar armada petugas mudah menemukan lokasi.')"
            placeholder="Tuliskan nama jalan, nomor rumah, RT/RW, dan patokan rumah..."
            required
            class="w-full px-4 py-3 rounded-2xl border-2 text-sm sm:text-base font-bold transition-colors focus:ring-4 focus:outline-none"
            :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-[#FACC15]' : 'border-slate-300 bg-white focus:border-purple-500 focus:ring-purple-300'"
          ></textarea>
        </div>

        <!-- Field 6: Kontak WhatsApp / HP Pendamping -->
        <div class="space-y-1.5">
          <label for="dis-telepon" class="block text-sm font-black flex items-center gap-1.5">
            <span>📱 6. Nomor HP / WhatsApp Aktif</span>
            <span class="text-red-500 font-bold" aria-hidden="true">*</span>
          </label>
          <input
            id="dis-telepon"
            type="tel"
            x-model="telepon"
            @focus="speakField('Kolom Nomor WhatsApp atau HP aktif pemohon atau keluarga pendamping.')"
            @click="speakField('Kolom Nomor WhatsApp atau HP aktif pemohon atau keluarga pendamping.')"
            placeholder="Contoh: 081234567890"
            required
            class="w-full px-4 py-3 rounded-xl border-2 font-mono text-sm sm:text-base font-bold transition-colors focus:ring-4 focus:outline-none"
            :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-[#FACC15]' : 'border-slate-300 bg-white focus:border-purple-500 focus:ring-purple-300'"
          />
        </div>

        <!-- Tombol Submit: Bersuara Otomatis & Bunyi Sukses Harmonis -->
        <div class="pt-2">
          <button
            type="submit"
            class="w-full py-4 sm:py-5 px-6 rounded-2xl font-black text-lg border-2 transition-all focus:ring-4 flex items-center justify-center gap-3 cursor-pointer shadow-lg active:scale-98"
            :class="colorFilter === 'high-contrast' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300 focus:ring-white' : 'bg-purple-700 text-white border-purple-800 hover:bg-purple-800 focus:ring-purple-300'"
          >
            <span>Kirim Pendaftaran KTP Disabilitas</span>
            <span aria-hidden="true" class="text-2xl">➔</span>
          </button>
        </div>
      </form>
    </div>

  </div>

  <script is:inline>
    function disabilitasAudioFirstPage() {
      return {
        nik: '',
        nama: '',
        ragam: 'fisik',
        layanan: 'jemput_bola',
        alamat: '',
        telepon: '',
        isSuccess: false,
        savedReg: '',
        isSpeaking: false,

        // Web Speech API Helper
        speakField(text) {
          if (!('speechSynthesis' in window)) return;
          window.speechSynthesis.cancel();
          const u = new SpeechSynthesisUtterance(text);
          u.lang = 'id-ID';
          u.rate = 0.95;

          const voices = window.speechSynthesis.getVoices();
          const idV = voices.find(v => v.lang === 'id-ID' || v.lang.startsWith('id'));
          if (idV) u.voice = idV;

          window.speechSynthesis.speak(u);
        },

        speakNotice(text) {
          this.speakField(text);
        },

        // Suarakan saat pilihan disabilitas berubah
        onRagamChange(val) {
          let text = '';
          if (val === 'fisik') text = 'Memilih Disabilitas Fisik atau Pengguna Kursi Roda. Petugas akan menyiapkan aksesibilitas mobilitas.';
          else if (val === 'netra') text = 'Memilih Disabilitas Sensorik Netra. Petugas akan memandu perekaman dengan deskripsi audio dan panduan sensorik.';
          else if (val === 'rungu') text = 'Memilih Disabilitas Sensorik Rungu atau Wicara. Petugas akan membawa Juru Bahasa Isyarat.';
          else if (val === 'intelektual') text = 'Memilih Disabilitas Intelektual atau Kondisi Tirah Baring di Tempat Tidur.';
          this.speakField(text);
        },

        // Suarakan saat opsi layanan berubah
        onLayananChange(val) {
          let text = '';
          if (val === 'jemput_bola') text = 'Memilih layanan petugas jemput bola rekam KTP datang langsung ke rumah.';
          else text = 'Memilih datang langsung ke kantor dinas dengan fasilitas loket jalur khusus prioritas.';
          this.speakField(text);
        },

        // Tombol Darurat Audio: Bacakan Seluruh Form
        readEntireForm() {
          if (!('speechSynthesis' in window)) return;
          if (this.isSpeaking) {
            window.speechSynthesis.cancel();
            this.isSpeaking = false;
            return;
          }

          window.speechSynthesis.cancel();
          const text = 'Panduan lengkap Formulir Disabilitas KITA-KTP. Pertama, masukkan 16 digit NIK Anda. Kedua, ketik nama lengkap Anda. Ketiga, pilih ragam disabilitas apakah fisik kursi roda, sensorik netra, rungu wicara, atau intelektual. Keempat, tentukan metode apakah petugas datang ke rumah atau Anda datang ke kantor. Kelima, tuliskan alamat rumah penjemputan dan nomor WhatsApp aktif. Terakhir, tekan tombol Kirim Pendaftaran di bagian bawah.';
          const u = new SpeechSynthesisUtterance(text);
          u.lang = 'id-ID';
          u.rate = 0.95;

          u.onstart = () => { this.isSpeaking = true; };
          u.onend = () => { this.isSpeaking = false; };
          u.onerror = () => { this.isSpeaking = false; };

          window.speechSynthesis.speak(u);
        },

        // Submit Handler dengan Suara Proses & Nada Harmonis
        submitDisabilitas() {
          if (this.nik.length !== 16 || !this.nama.trim() || !this.alamat.trim() || !this.telepon.trim()) {
            this.speakField('Mohon maaf, mohon lengkapi NIK 16 digit, Nama Lengkap, Alamat Rumah, dan Nomor Telepon Anda.');
            alert('Mohon lengkapi seluruh kolom formulir.');
            return;
          }

          // Bersuara proses submit
          this.speakField('Memproses pengajuan KTP khusus disabilitas. Mohon tunggu sebentar.');

          // Generate Registration ID
          const reg = 'KITA-2026-' + Math.floor(1000 + Math.random() * 9000);
          const ragamLabel = {
            fisik: 'Disabilitas Fisik / Kursi Roda',
            netra: 'Disabilitas Sensorik Netra',
            rungu: 'Disabilitas Sensorik Rungu / Isyarat',
            intelektual: 'Disabilitas Intelektual / Tirah Baring'
          }[this.ragam] || 'Disabilitas';

          const record = {
            id: reg,
            regNumber: reg,
            nik: this.nik,
            nama: this.nama,
            kategori: 'Disabilitas',
            kebutuhan: ragamLabel,
            layanan: this.layanan,
            alamat: this.alamat,
            telepon: this.telepon,
            createdAt: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) + ' WIB',
            step: 1,
            statusTitle: 'Pengajuan Layanan Inklusif Berhasil Diproses',
            statusMessage: 'Tim unit jemput bola bersama pendamping telah mencatat permohonan. Petugas akan melakukan konfirmasi sebelum kedatangan armada rekam KTP.',
            estimasi: '1 - 2 Hari Kerja'
          };

          const KEY = 'kita_ktp_records';
          let records = [];
          try { records = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { records = []; }
          records.unshift(record);
          localStorage.setItem(KEY, JSON.stringify(records));

          this.savedReg = reg;
          this.isSuccess = true;

          // Play Web Audio API Success Tone
          this.playSuccessTone();

          // Vocal Confirmation
          setTimeout(() => {
            if ('speechSynthesis' in window) {
              window.speechSynthesis.cancel();
              const voiceConfirm = new SpeechSynthesisUtterance('Pendaftaran layanan disabilitas berhasil. Nomor registrasi Anda adalah ' + reg.replace(/-/g, ' '));
              voiceConfirm.lang = 'id-ID';
              window.speechSynthesis.speak(voiceConfirm);
            }
          }, 1200);
        },

        playSuccessTone() {
          try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            const ctx = new AudioCtx();
            const notes = [523.25, 659.25, 783.99, 1046.50];
            notes.forEach((freq, i) => {
              const osc = ctx.createOscillator();
              const gain = ctx.createGain();
              const start = ctx.currentTime + (i * 0.08);

              osc.type = 'triangle';
              osc.frequency.setValueAtTime(freq, start);
              gain.gain.setValueAtTime(0.14, start);
              gain.gain.exponentialRampToValueAtTime(0.001, start + 0.25);

              osc.connect(gain);
              gain.connect(ctx.destination);

              osc.start(start);
              osc.stop(start + 0.25);
            });
          } catch (e) {}
        }
      };
    }
  </script>
</MainLayout>
