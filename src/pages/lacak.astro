---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Pelacakan Status Berkas Dokumen — KITA-TERPADU"
  description="Lacak tahapan proses permohonan KTP-el, KK, dan berkas kependudukan secara real-time dan transparan."
>
  <div x-data="lacakUniversal()" x-init="initDashboard()" class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-8 w-full max-w-full overflow-x-hidden">

    <!-- Top Breadcrumb & Audio Button -->
    <div class="flex items-center justify-between gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 font-bold text-xs sm:text-sm text-slate-500 hover:text-slate-900 transition-colors"
        :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15] hover:underline' : ''"
      >
        <span aria-hidden="true">⬅</span>
        <span>Kembali ke Beranda</span>
      </a>

      <button
        type="button"
        @click="bacaAudioPanduan()"
        class="px-3.5 py-1.5 rounded-xl text-xs font-black border transition-all inline-flex items-center gap-1.5 cursor-pointer shadow-xs active:scale-95"
        :class="isSpeaking
          ? (temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-amber-400 text-slate-950 border-amber-500 animate-pulse')
          : (temaDisabilitas === 'netra-kontras' ? 'bg-black text-[#FACC15] border-[#FACC15]' : 'bg-slate-900 text-white border-slate-900 hover:bg-slate-800')"
      >
        <span aria-hidden="true" x-text="isSpeaking ? '⏹️' : '🔊'"></span>
        <span x-text="isSpeaking ? 'Hentikan Suara' : 'Panduan Audio'"></span>
      </button>
    </div>

    <!-- FORM PENCARIAN NIK ATAU NOMOR TIKET -->
    <section
      aria-labelledby="lacak-title"
      class="rounded-3xl p-5 sm:p-8 border-2 transition-all space-y-5 shadow-xs"
      :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-slate-200 bg-white'"
    >
      <div class="flex items-center gap-3">
        <div
          class="w-12 h-12 rounded-2xl flex items-center justify-center text-2xl border shadow-xs shrink-0"
          :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-blue-50 text-blue-700 border-blue-200'"
        >
          🔍
        </div>
        <div>
          <span
            class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider border"
            :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-blue-200 bg-blue-50 text-blue-800'"
          >
            Sistem Audit Dokumen
          </span>
          <h1 id="lacak-title" class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight mt-0.5">
            Pelacakan Berkas Terpadu KITA-TERPADU
          </h1>
        </div>
      </div>

      <p class="text-xs sm:text-sm font-semibold leading-relaxed" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/90' : 'text-slate-600'">
        Ketik <strong>Nomor Registrasi</strong> (contoh: <code class="font-mono font-bold">KT-20260923-XXXX</code>) atau <strong>NIK 16 Digit</strong> Anda:
      </p>

      <!-- Input Bar -->
      <div class="flex flex-col sm:flex-row gap-2.5">
        <div class="flex-1 relative">
          <label for="search-input" class="sr-only">Nomor Registrasi atau NIK</label>
          <input
            id="search-input"
            type="text"
            x-model="searchQuery"
            @keyup.enter="cariBerkas()"
            placeholder="Nomor Tiket KT-... atau 16 Digit NIK"
            class="w-full px-4 py-3 rounded-2xl border-2 font-mono text-sm sm:text-base font-bold focus:outline-none focus:ring-4 transition-all"
            :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 bg-white focus:border-blue-600 focus:ring-blue-200'"
          />
        </div>
        <button
          type="button"
          @click="cariBerkas()"
          class="px-6 py-3 rounded-2xl font-black text-sm border-2 transition-all cursor-pointer shadow-xs active:scale-95 flex items-center justify-center gap-1.5"
          :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300' : 'bg-blue-600 text-white border-blue-600 hover:bg-blue-700'"
        >
          <span>Lacak Berkas</span>
          <span aria-hidden="true">➔</span>
        </button>
      </div>

      <!-- Quick Demo Seeds -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="font-bold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : ''">Coba Cepat:</span>
        <button
          type="button"
          @click="quickSelect('8812')"
          class="px-2.5 py-1 rounded-xl border text-[11px] font-mono font-bold cursor-pointer"
          :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] hover:bg-[#FACC15] hover:text-black' : 'border-amber-300 bg-amber-50 text-amber-950 hover:bg-amber-100'"
        >
          ...8812 (Lansia)
        </button>
        <button
          type="button"
          @click="quickSelect('5419')"
          class="px-2.5 py-1 rounded-xl border text-[11px] font-mono font-bold cursor-pointer"
          :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] hover:bg-[#FACC15] hover:text-black' : 'border-purple-300 bg-purple-50 text-purple-950 hover:bg-purple-100'"
        >
          ...5419 (Disabilitas)
        </button>
        <button
          type="button"
          @click="quickSelect('3104')"
          class="px-2.5 py-1 rounded-xl border text-[11px] font-mono font-bold cursor-pointer"
          :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] hover:bg-[#FACC15] hover:text-black' : 'border-blue-300 bg-blue-50 text-blue-950 hover:bg-blue-100'"
        >
          ...3104 (Umum)
        </button>
      </div>
    </section>

    <!-- CARD HASIL PENCARIAN DENGAN VISUAL STATUS BERTAHAP -->
    <template x-if="selectedRecord">
      <section
        aria-labelledby="result-title"
        class="rounded-3xl p-5 sm:p-8 border-2 transition-all space-y-6 shadow-xs"
        :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-slate-200 bg-white'"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40' : 'border-slate-200'">
          <div>
            <span class="block text-xs font-bold text-slate-400">Nomor Registrasi:</span>
            <h2 id="result-title" class="text-lg sm:text-xl font-black font-mono tracking-wider text-blue-700" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : ''" x-text="selectedRecord.regNumber"></h2>
          </div>
          <span
            class="px-3 py-1 rounded-full text-xs font-black border self-start sm:self-auto"
            :class="selectedRecord.step === 4 ? 'bg-emerald-100 text-emerald-950 border-emerald-300' : 'bg-blue-50 text-blue-900 border-blue-300'"
          >
            Tahap <span x-text="selectedRecord.step"></span> dari 4
          </span>
        </div>

        <!-- VISUAL STATUS BERTAHAP (Diterima -> Verifikasi -> Penjadwalan -> Selesai) -->
        <div class="space-y-3">
          <span class="text-xs font-black uppercase tracking-wider text-slate-400">Tahapan Pemrosesan:</span>

          <div class="grid grid-cols-1 sm:grid-cols-4 gap-2.5">
            <!-- Tahap 1: Diterima -->
            <div
              class="p-3.5 rounded-2xl border-2 space-y-1.5"
              :class="selectedRecord.step >= 1 ? (temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-neutral-950' : 'border-blue-500 bg-blue-50/70 text-blue-950') : 'border-slate-200 opacity-40'"
            >
              <div class="flex items-center justify-between text-xs font-black">
                <span>1. Diterima</span>
                <span x-show="selectedRecord.step > 1">✓</span>
              </div>
              <p class="text-[11px] text-slate-500 leading-tight" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">Berkas tercatat di sistem</p>
            </div>

            <!-- Tahap 2: Verifikasi Berkas -->
            <div
              class="p-3.5 rounded-2xl border-2 space-y-1.5"
              :class="selectedRecord.step >= 2 ? (temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-neutral-950' : 'border-blue-500 bg-blue-50/70 text-blue-950') : 'border-slate-200 opacity-40'"
            >
              <div class="flex items-center justify-between text-xs font-black">
                <span>2. Verifikasi</span>
                <span x-show="selectedRecord.step > 2">✓</span>
              </div>
              <p class="text-[11px] text-slate-500 leading-tight" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">Validasi data Dukcapil</p>
            </div>

            <!-- Tahap 3: Penjadwalan -->
            <div
              class="p-3.5 rounded-2xl border-2 space-y-1.5"
              :class="selectedRecord.step >= 3 ? (temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-neutral-950' : 'border-blue-500 bg-blue-50/70 text-blue-950') : 'border-slate-200 opacity-40'"
            >
              <div class="flex items-center justify-between text-xs font-black">
                <span>3. Penjadwalan</span>
                <span x-show="selectedRecord.step > 3">✓</span>
              </div>
              <p class="text-[11px] text-slate-500 leading-tight" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">Jemput bola / sesi loket</p>
            </div>

            <!-- Tahap 4: Selesai -->
            <div
              class="p-3.5 rounded-2xl border-2 space-y-1.5"
              :class="selectedRecord.step === 4 ? (temaDisabilitas === 'netra-kontras' ? 'border-emerald-400 bg-neutral-950' : 'border-emerald-500 bg-emerald-50/70 text-emerald-950') : 'border-slate-200 opacity-40'"
            >
              <div class="flex items-center justify-between text-xs font-black">
                <span>4. Selesai</span>
                <span x-show="selectedRecord.step === 4">✓</span>
              </div>
              <p class="text-[11px] text-slate-500 leading-tight" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">Dokumen diterbitkan</p>
            </div>
          </div>
        </div>

        <!-- Detail Data -->
        <div class="p-4 rounded-2xl border space-y-3" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40 bg-neutral-950' : 'border-slate-200 bg-slate-50/60'">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h3 class="text-sm font-black" x-text="selectedRecord.statusTitle"></h3>
              <p class="text-xs text-slate-600 mt-0.5" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/90' : ''" x-text="selectedRecord.statusMessage"></p>
            </div>
            <span class="text-xs font-bold font-mono self-start sm:self-auto" x-text="selectedRecord.estimasi"></span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-2.5 border-t text-xs">
            <div>
              <span class="block font-bold text-slate-400">Pemohon:</span>
              <span class="font-black" x-text="selectedRecord.nama"></span>
            </div>
            <div>
              <span class="block font-bold text-slate-400">NIK:</span>
              <span class="font-black font-mono" x-text="selectedRecord.nik"></span>
            </div>
            <div>
              <span class="block font-bold text-slate-400">Layanan:</span>
              <span class="font-black" x-text="selectedRecord.layanan"></span>
            </div>
          </div>
        </div>

        <!-- Action Buttons (Print & Delete CRUD) -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40' : 'border-slate-200'">
          <button
            type="button"
            @click="window.print()"
            class="w-full sm:w-auto px-4 py-2 rounded-xl border text-xs font-black cursor-pointer flex items-center justify-center gap-1.5"
            :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] text-[#FACC15]' : 'border-slate-300 text-slate-700 hover:bg-slate-100'"
          >
            <span>🖨️ Cetak Bukti Resi</span>
          </button>

          <!-- Fitur Pembatalan Pengajuan untuk Simulasi CRUD Data Demo -->
          <button
            type="button"
            @click="batalkanPengajuan(selectedRecord.id)"
            class="w-full sm:w-auto px-4 py-2 rounded-xl border text-xs font-black cursor-pointer flex items-center justify-center gap-1.5"
            :class="temaDisabilitas === 'netra-kontras' ? 'border-red-500 text-red-400 hover:bg-red-950' : 'border-rose-200 bg-rose-50 text-rose-800 hover:bg-rose-100'"
          >
            <span>🗑️ Batalkan Pengajuan Ini</span>
          </button>
        </div>
      </section>
    </template>

    <!-- State Not Found -->
    <template x-if="searchPerformed && !selectedRecord">
      <div class="p-6 sm:p-8 rounded-3xl border-2 text-center space-y-2" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-slate-200 bg-white'">
        <span class="text-3xl">⚠️</span>
        <h3 class="text-base font-black">Dokumen Tidak Ditemukan</h3>
        <p class="text-xs text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
          Silakan periksa kembali nomor registrasi Anda atau pilih dari riwayat di bawah ini.
        </p>
      </div>
    </template>

    <!-- RIWAYAT PERMOHONAN DI PERAMBAN -->
    <section aria-labelledby="history-title" class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40' : 'border-slate-200'">
        <h2 id="history-title" class="text-base sm:text-lg font-black tracking-tight" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'">
          Riwayat Pengajuan Peramban
        </h2>
        <span class="text-xs font-black font-mono text-slate-500" x-text="recordsList.length + ' Berkas'"></span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        <template x-for="item in recordsList" :key="item.id">
          <div
            @click="selectItem(item)"
            class="p-4 rounded-2xl border-2 transition-all cursor-pointer flex flex-col justify-between gap-2.5 shadow-2xs hover:shadow-sm"
            :class="selectedRecord && selectedRecord.id === item.id
              ? (temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-neutral-900 ring-2 ring-[#FACC15]' : 'border-blue-600 bg-blue-50/70 ring-2 ring-blue-300')
              : (temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40 bg-black text-[#FACC15]' : 'border-slate-200 bg-white hover:border-slate-300')"
          >
            <div class="space-y-1">
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-xs font-black text-blue-700" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : ''" x-text="item.regNumber"></span>
                <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded-full border" x-text="'Tahap ' + item.step + '/4'"></span>
              </div>
              <h3 class="font-black text-xs sm:text-sm" x-text="item.nama"></h3>
              <p class="text-xs font-semibold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''" x-text="item.layanan"></p>
            </div>

            <div class="pt-2 border-t flex items-center justify-between text-xs font-bold" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/30' : 'border-slate-100'">
              <span class="text-slate-400 text-[11px]" x-text="item.tanggal"></span>
              <span class="text-blue-600 font-black">Lacak ➔</span>
            </div>
          </div>
        </template>
      </div>
    </section>

  </div>

  <script is:inline>
    function lacakUniversal() {
      return {
        searchQuery: '',
        searchPerformed: false,
        selectedRecord: null,
        recordsList: [],
        isSpeaking: false,

        initDashboard() {
          this.muatData();
          if (this.recordsList.length > 0) {
            this.selectedRecord = this.recordsList[0];
          }

          const params = new URLSearchParams(window.location.search);
          const q = params.get('reg') || params.get('id');
          if (q) {
            this.searchQuery = q;
            this.cariBerkas();
          }
        },

        muatData() {
          const KEY = 'semua_pengajuan_layanan';
          try {
            const raw = localStorage.getItem(KEY);
            if (raw) this.recordsList = JSON.parse(raw);
          } catch (e) {}
        },

        cariBerkas() {
          this.searchPerformed = true;
          const q = this.searchQuery.trim().toLowerCase();
          if (!q) return;

          const match = this.recordsList.find(r =>
            (r.regNumber && r.regNumber.toLowerCase().includes(q)) ||
            (r.id && r.id.toLowerCase().includes(q)) ||
            (r.nik && r.nik.includes(q))
          );

          this.selectedRecord = match || null;
        },

        quickSelect(snippet) {
          const match = this.recordsList.find(r => r.regNumber && r.regNumber.includes(snippet));
          if (match) {
            this.searchQuery = match.regNumber;
            this.selectedRecord = match;
            this.searchPerformed = true;
          }
        },

        selectItem(item) {
          this.selectedRecord = item;
          this.searchQuery = item.regNumber;
          window.scrollTo({ top: 120, behavior: 'smooth' });
        },

        batalkanPengajuan(id) {
          if (!confirm('Apakah Anda yakin ingin membatalkan pengajuan ini? Data akan dihapus dari sistem demo.')) {
            return;
          }

          const KEY = 'semua_pengajuan_layanan';
          this.recordsList = this.recordsList.filter(r => r.id !== id && r.regNumber !== id);
          localStorage.setItem(KEY, JSON.stringify(this.recordsList));

          if (this.selectedRecord && (this.selectedRecord.id === id || this.selectedRecord.regNumber === id)) {
            this.selectedRecord = this.recordsList.length > 0 ? this.recordsList[0] : null;
          }

          alert('Pengajuan telah berhasil dibatalkan.');
        },

        bacaAudioPanduan() {
          if (!('speechSynthesis' in window)) return;

          if (this.isSpeaking) {
            window.speechSynthesis.cancel();
            this.isSpeaking = false;
            return;
          }

          this.isSpeaking = true;
          const teks = "Halaman pelacakan status berkas KITA-TERPADU. Masukkan nomor registrasi atau NIK Anda di kolom pencarian. Status ditampilkan dalam empat tahap: diterima, verifikasi berkas, penjadwalan, dan selesai.";
          const utterance = new SpeechSynthesisUtterance(teks);
          utterance.lang = 'id-ID';
          utterance.onend = () => { this.isSpeaking = false; };
          utterance.onerror = () => { this.isSpeaking = false; };
          window.speechSynthesis.speak(utterance);
        }
      };
    }
  </script>
</MainLayout>
