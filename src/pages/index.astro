---
import MainLayout from '../layouts/MainLayout.astro';

const priorityGates = [
  {
    id: 'lansia',
    badge: 'Jemput Bola Armada',
    badgeClass: 'bg-amber-100 text-amber-950 border-amber-300',
    title: 'Gerbang Prioritas Lansia',
    subtitle: 'Warga Usia 60 Tahun ke Atas',
    desc: 'Fasilitas jemput bola ke kediaman tanpa perlu antre di loket. Petugas Dukcapil hadir membawa perangkat rekam biometrik portabel khusus warga tirah baring.',
    icon: '🧓',
    link: '/layanan/lansia',
    cta: 'Panggil Petugas Lansia ➔',
    borderClass: 'border-amber-200 hover:border-amber-400 bg-amber-50/50'
  },
  {
    id: 'disabilitas',
    badge: 'Fasilitas Aksesibel',
    badgeClass: 'bg-purple-100 text-purple-950 border-purple-300',
    title: 'Gerbang Khusus Disabilitas',
    subtitle: 'Sensorik, Fisik, Intelektual & Mental',
    desc: 'Dukungan formulir suara (TTS), pendampingan juru bahasa isyarat, dan armada jemput bola perekaman sidik jari & iris mata langsung ke panti sosial atau rumah.',
    icon: '♿',
    link: '/layanan/disabilitas',
    cta: 'Daftar Layanan Disabilitas ➔',
    borderClass: 'border-purple-200 hover:border-purple-400 bg-purple-50/50'
  },
  {
    id: 'umum',
    badge: 'Antrean Cerdas Digital',
    badgeClass: 'bg-blue-100 text-blue-950 border-blue-300',
    title: 'Gerbang Mandiri & Umum',
    subtitle: 'Seluruh Penduduk Indonesia',
    desc: 'Registrasi online mandiri, pemesanan nomor antrean loket kecamatan tanpa calo, penelusuran berkas instan, dan estimasi waktu tunggu transparan.',
    icon: '🏢',
    link: '/layanan/ktp',
    cta: 'Buka Loket Mandiri ➔',
    borderClass: 'border-blue-200 hover:border-blue-400 bg-blue-50/50'
  }
];

const directoryServices = [
  {
    slug: 'ktp',
    icon: '🪪',
    title: 'KTP-el / Identitas',
    category: 'Identitas Pokok',
    badge: 'Jemput Bola & Loket',
    badgeColor: 'bg-blue-50 text-blue-800 border-blue-200',
    desc: 'Perekaman pemula 17 tahun, penggantian KTP rusak/hilang, dan pembaruan foto/biometrik.',
    sla: '1-2 Hari Kerja'
  },
  {
    slug: 'kk',
    icon: '👨‍👩‍👧',
    title: 'Kartu Keluarga (KK)',
    category: 'Dokumen Keluarga',
    badge: 'Online & Cetak Mandiri',
    badgeColor: 'bg-indigo-50 text-indigo-800 border-indigo-200',
    desc: 'Pecah KK baru, penambahan anggota keluarga lahir/pindah, dan pemutakhiran biodata kepala keluarga.',
    sla: '1 Hari Kerja'
  },
  {
    slug: 'kia',
    icon: '👶',
    title: 'KIA / Identitas Anak',
    category: 'Hak Sipil Anak',
    badge: 'Online & Kurir Dinas',
    badgeColor: 'bg-pink-50 text-pink-800 border-pink-200',
    desc: 'Penerbitan kartu identitas resmi anak usia 0-17 tahun terintegrasi kutipan akta kelahiran.',
    sla: '2 Hari Kerja'
  },
  {
    slug: 'bpjs',
    icon: '🏥',
    title: 'BPJS Kesehatan',
    category: 'Jaminan Sosial',
    badge: 'Sinkronisasi NIK PBI',
    badgeColor: 'bg-emerald-50 text-emerald-800 border-emerald-200',
    desc: 'Verifikasi kepesertaan PBI bantuan pemerintah, pembaharuan faskes tingkat 1, dan validasi data terpadu.',
    sla: 'Instan / 24 Jam'
  },
  {
    slug: 'bansos',
    icon: '💰',
    title: 'Bantuan Sosial (Bansos)',
    category: 'Bansos & DTKS',
    badge: 'Cek Desil & Usulan',
    badgeColor: 'bg-amber-50 text-amber-800 border-amber-200',
    desc: 'Pengecekan desil kemiskinan DTKS, usulan program sembako tunai, PKH, dan validasi lapangan dinas sosial.',
    sla: '3 Hari Kerja'
  },
  {
    slug: 'disabilitas',
    icon: '♿',
    title: 'Layanan Disabilitas',
    category: 'Inklusi Prioritas',
    badge: 'Jemput Bola Prioritas',
    badgeColor: 'bg-purple-50 text-purple-800 border-purple-200',
    desc: 'Pendampingan sensorik netra/rungu, juru bahasa isyarat, dan perekaman dokumen ke rumah.',
    sla: 'Prioritas Utama'
  },
  {
    slug: 'lansia',
    icon: '🧓',
    title: 'Layanan Lansia',
    category: 'Prioritas Usia 60+',
    badge: 'Armada Khusus Rumah',
    badgeColor: 'bg-orange-50 text-orange-800 border-orange-200',
    desc: 'Percepatan cetak KTP seumur hidup dan kunjungan tim administrasi keliling ke kediaman pemohon.',
    sla: 'Prioritas Utama'
  },
  {
    slug: 'domisili',
    icon: '🏠',
    title: 'Pindah Domisili',
    category: 'Mobilitas Warga',
    badge: 'SKPWNI Digital',
    badgeColor: 'bg-teal-50 text-teal-800 border-teal-200',
    desc: 'Penerbitan Surat Keterangan Pindah Warga Negara Indonesia (SKPWNI) antar RT, kelurahan, dan provinsi.',
    sla: '1-2 Hari Kerja'
  },
  {
    slug: 'akta',
    icon: '📄',
    title: 'Akta Lahir & Kematian',
    category: 'Catatan Sipil',
    badge: 'QR Code Resmi',
    badgeColor: 'bg-cyan-50 text-cyan-800 border-cyan-200',
    desc: 'Penerbitan kutipan akta kelahiran baru, akta kematian, serta pembaharuan silsilah hukum keluarga.',
    sla: '2 Hari Kerja'
  },
  {
    slug: 'pendatang',
    icon: '🗺️',
    title: 'Panduan Warga Baru',
    category: 'Integrasi Wilayah',
    badge: 'Integrasi RT/RW',
    badgeColor: 'bg-sky-50 text-sky-800 border-sky-200',
    desc: 'Pelaporan kedatangan warga baru, pendaftaran domisili sementara, dan integrasi data lingkungan tinggal.',
    sla: '1 Hari Kerja'
  },
  {
    slug: 'laporan',
    icon: '📢',
    title: 'Pengaduan & Laporan',
    category: 'Transparansi Publik',
    badge: 'Respons 1x24 Jam',
    badgeColor: 'bg-rose-50 text-rose-800 border-rose-200',
    desc: 'Saluran aduan pungli, kendala biometrik, ketidaksesuaian data NIK, serta monitoring berkas terkendala.',
    sla: 'Maks. 24 Jam'
  }
];
---

<MainLayout
  title="KITA-KTP — Portal Administrasi Kependudukan Inklusif Nasional"
  description="Layanan Administrasi Kependudukan Terpadu, Bebas Biaya, Ramah Lansia dan Difabel Republik Indonesia."
>
  <div class="space-y-16 sm:space-y-24" x-data="{ isHeroSpeaking: false }">

    <!-- 1. HERO BANNER BERKELAS NASIONAL (Split Grid Editorial Modern) -->
    <section aria-labelledby="hero-title" class="pt-2 sm:pt-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Sisi Kiri: Headline Tajam & Transparansi Publik -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <!-- Official Tagline Badge -->
          <div
            class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-black border transition-all"
            :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-blue-200 bg-blue-50 text-blue-950 shadow-2xs'"
          >
            <span class="text-sm">🇮🇩</span>
            <span class="tracking-wide uppercase text-[10px] sm:text-xs">Sistem Administrasi Kependudukan Digital Terpadu RI</span>
          </div>

          <!-- Headline Utama Berwibawa -->
          <h1
            id="hero-title"
            class="text-3xl sm:text-5xl lg:text-5xl font-black tracking-tight leading-[1.15]"
            :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'"
          >
            Kesetaraan Hak Kependudukan Tanpa Batas Ruang dan Kondisi Fisik
          </h1>

          <!-- Deskripsi Transparansi Publik -->
          <p
            class="text-sm sm:text-base lg:text-lg font-medium leading-relaxed max-w-2xl"
            :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/90' : 'text-slate-600'"
          >
            Komitmen negara menghadirkan administrasi kependudukan yang <strong>100% bebas biaya</strong>, tanpa diskriminasi, dan tanpa perantara pungli. Setiap warga negara berhak atas kemudahan memperoleh KTP-el, Kartu Keluarga, dan Akta Sipil melalui layanan mandiri maupun <strong>armada jemput bola</strong> langsung ke rumah.
          </p>

          <!-- Audio Reader & CTA Buttons -->
          <div class="pt-2 flex flex-wrap items-center gap-3">
            <!-- Tombol Narasi Ringkasan Beranda -->
            <button
              type="button"
              @click="
                bunyiKlik(800);
                if (isHeroSpeaking) {
                  hentikanSuara();
                  isHeroSpeaking = false;
                } else {
                  isHeroSpeaking = true;
                  bacaTeks('Selamat datang di Portal Kependudukan KITA-KTP Republik Indonesia. Portal ini menjamin hak identitas kependudukan yang setara bagi seluruh warga, termasuk lansia dan penyandang disabilitas dengan layanan jemput bola ke rumah tanpa biaya.');
                }
              "
              class="px-4 sm:px-5 py-3 rounded-2xl text-xs sm:text-sm font-black border-2 transition-all flex items-center gap-2 cursor-pointer shadow-sm active:scale-95"
              :class="isHeroSpeaking
                ? (temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-amber-400 text-slate-950 border-amber-500 animate-pulse')
                : (temaDisabilitas === 'netra-kontras' ? 'bg-black text-[#FACC15] border-[#FACC15] hover:bg-neutral-900' : 'bg-white text-slate-800 border-slate-300 hover:bg-slate-100')"
            >
              <span class="text-base" x-text="isHeroSpeaking ? '⏹️' : '🔊'"></span>
              <span x-text="isHeroSpeaking ? 'Hentikan Audio' : 'Dengarkan Ringkasan Beranda'"></span>
            </button>

            <!-- CTA: Jelajahi Layanan -->
            <a
              href="#direktori-layanan"
              @click="bunyiKlik(800)"
              class="px-5 py-3 rounded-2xl text-xs sm:text-sm font-black border transition-all flex items-center gap-2 shadow-sm active:scale-95"
              :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300' : 'bg-blue-600 text-white border-blue-600 hover:bg-blue-700'"
            >
              <span>Jelajahi 11 Layanan</span>
              <span aria-hidden="true">↓</span>
            </a>

            <!-- CTA: Lacak Tiket -->
            <a
              href="/lacak"
              @click="bunyiKlik(800)"
              class="px-5 py-3 rounded-2xl text-xs sm:text-sm font-black border transition-all flex items-center gap-2 shadow-sm active:scale-95"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] text-[#FACC15] hover:bg-neutral-900' : 'bg-slate-900 text-white border-slate-900 hover:bg-slate-800'"
            >
              <span>🔍 Lacak Permohonan</span>
            </a>
          </div>
        </div>

        <!-- Sisi Kanan: Foto Editorial Resolusi Tinggi dengan Badge Metrik -->
        <div class="lg:col-span-5 relative">
          <!-- Bingkai Foto Editorial Berkelas -->
          <div
            class="relative rounded-3xl overflow-hidden border-2 shadow-2xl transition-transform duration-300 hover:scale-[1.01]"
            :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-neutral-950' : 'border-slate-200 bg-white'"
          >
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=1000&auto=format&fit=crop"
              alt="Petugas pelayanan kependudukan berdedikasi melayani warga lansia dan masyarakat dengan ramah dan inklusif"
              class="w-full h-80 sm:h-96 object-cover object-center filter contrast-105"
              loading="eager"
            />

            <!-- Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

            <!-- Keterangan Foto Editorial -->
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="inline-block text-[10px] font-black uppercase tracking-wider bg-blue-600 px-2.5 py-0.5 rounded-full mb-1">
                Layanan Jemput Bola Terpadu
              </span>
              <p class="text-xs font-bold leading-snug drop-shadow-sm">
                Petugas Dukcapil hadir ke rumah warga lansia dan difabel untuk perekaman data kependudukan.
              </p>
            </div>
          </div>

          <!-- Floating Badges Metrik Modern -->
          <div class="absolute -top-3 -right-3 hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-white shadow-xl border border-slate-200 text-slate-900" :class="temaDisabilitas === 'netra-kontras' ? 'bg-black! text-[#FACC15]! border-[#FACC15]!' : ''">
            <span class="w-7 h-7 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-black text-sm">✓</span>
            <div>
              <span class="block text-[11px] font-black leading-tight">100% Bebas Biaya</span>
              <span class="block text-[9px] font-semibold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">Sesuai UU Adminduk</span>
            </div>
          </div>

          <div class="absolute -bottom-4 -left-3 hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-white shadow-xl border border-slate-200 text-slate-900" :class="temaDisabilitas === 'netra-kontras' ? 'bg-black! text-[#FACC15]! border-[#FACC15]!' : ''">
            <span class="w-7 h-7 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-black text-sm">🚐</span>
            <div>
              <span class="block text-[11px] font-black leading-tight">Jemput Bola Terverifikasi</span>
              <span class="block text-[9px] font-semibold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">Khusus Difabel & Lansia</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. TIGA KARTU GERBANG PRIORITAS KHUSUS -->
    <section aria-labelledby="gerbang-prioritas-title" class="space-y-6">
      <div class="text-left space-y-1">
        <h2
          id="gerbang-prioritas-title"
          class="text-2xl sm:text-3xl font-black tracking-tight"
          :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'"
        >
          Tiga Gerbang Akses Pelayanan Publik
        </h2>
        <p class="text-xs sm:text-sm font-semibold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
          Pilih jalur pelayanan yang paling sesuai dengan kondisi fisik dan kebutuhan Anda
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {priorityGates.map((gate) => (
          <div
            class={`relative rounded-3xl p-6 border-2 transition-all duration-300 hover:-translate-y-1 shadow-xs hover:shadow-xl flex flex-col justify-between ${gate.borderClass}`}
            :class="temaDisabilitas === 'netra-kontras' ? 'bg-black! border-[#FACC15]! text-[#FACC15]!' : ''"
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-2">
                <span class="w-12 h-12 rounded-2xl bg-white shadow-xs border border-slate-200 flex items-center justify-center text-2xl shrink-0" :class="temaDisabilitas === 'netra-kontras' ? 'bg-neutral-900! border-[#FACC15]!' : ''">
                  {gate.icon}
                </span>
                <span class={`text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full border ${gate.badgeClass}`} :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15]! text-black! border-[#FACC15]!' : ''">
                  {gate.badge}
                </span>
              </div>

              <div>
                <h3 class="text-lg font-black tracking-tight" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'">
                  {gate.title}
                </h3>
                <span class="block text-xs font-bold text-slate-500 mt-0.5" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
                  {gate.subtitle}
                </span>
              </div>

              <p class="text-xs font-medium leading-relaxed" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/90' : 'text-slate-600'">
                {gate.desc}
              </p>
            </div>

            <div class="pt-6">
              <a
                href={gate.link}
                class="w-full py-3 px-4 rounded-xl text-xs font-black border transition-all flex items-center justify-center gap-2 cursor-pointer shadow-xs active:scale-95"
                :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300' : 'bg-slate-900 text-white border-slate-900 hover:bg-slate-800'"
              >
                <span>{gate.cta}</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. DIREKTORI LENGKAP 11 MODUL LAYANAN TERPADU -->
    <section id="direktori-layanan" aria-labelledby="direktori-layanan-title" class="space-y-6 pt-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-3 border-b" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40' : 'border-slate-200'">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-wider text-blue-600" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : ''">
            Portal Mandiri Terintegrasi
          </span>
          <h2
            id="direktori-layanan-title"
            class="text-2xl sm:text-3xl font-black tracking-tight"
            :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'"
          >
            Direktori 11 Modul Layanan Kependudukan
          </h2>
          <p class="text-xs sm:text-sm font-semibold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
            Pilih jenis dokumen untuk memulai formulir adaptif (Umum, Lansia, atau Disabilitas)
          </p>
        </div>

        <span
          class="inline-block px-3 py-1 rounded-full text-xs font-black border self-start sm:self-auto"
          :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-slate-300 bg-slate-100 text-slate-800'"
        >
          11 Layanan Aktif
        </span>
      </div>

      <!-- Modern Responsive Card Grid (2 di mobile, 3 di tablet, 4 di desktop) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {directoryServices.map((srv) => (
          <a
            href={`/layanan/${srv.slug}`}
            class="group relative rounded-3xl p-5 border-2 transition-all duration-200 hover:-translate-y-1 flex flex-col justify-between shadow-xs hover:shadow-xl focus:outline-none focus:ring-4 cursor-pointer"
            :class="temaDisabilitas === 'netra-kontras'
              ? 'border-[#FACC15] bg-black text-[#FACC15] hover:bg-neutral-900 focus:ring-white'
              : 'border-slate-200 bg-white hover:border-blue-400 focus:ring-blue-300'"
            aria-label={`Buka formulir pengajuan ${srv.title}`}
          >
            <div class="space-y-3">
              <!-- Top Row: Icon & Badge Alur -->
              <div class="flex items-start justify-between gap-2">
                <span
                  class="w-12 h-12 rounded-2xl flex items-center justify-center text-2xl border shadow-2xs transition-transform duration-200 group-hover:scale-110 shrink-0"
                  :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-slate-50 border-slate-200'"
                  aria-hidden="true"
                >
                  {srv.icon}
                </span>

                <span
                  class={`text-[9px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full border ${srv.badgeColor}`}
                  :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15]! text-black! border-[#FACC15]!' : ''"
                >
                  {srv.badge}
                </span>
              </div>

              <!-- Title & Category -->
              <div>
                <span class="block text-[10px] font-black uppercase tracking-wider text-slate-400" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/70' : ''">
                  {srv.category}
                </span>
                <h3 class="text-base font-black tracking-tight leading-snug group-hover:text-blue-600 transition-colors" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15] group-hover:text-yellow-300' : 'text-slate-900'">
                  {srv.title}
                </h3>
              </div>

              <!-- Description -->
              <p class="text-xs font-medium leading-relaxed line-clamp-3" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/90' : 'text-slate-600'">
                {srv.desc}
              </p>
            </div>

            <!-- Bottom Row: SLA & Action Button -->
            <div class="pt-4 mt-3 border-t flex items-center justify-between gap-2 text-xs font-bold" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/30' : 'border-slate-100'">
              <span class="text-[11px] text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
                ⏱️ {srv.sla}
              </span>
              <span class="text-blue-600 font-black group-hover:translate-x-1 transition-transform inline-flex items-center gap-1" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : ''">
                Daftar ➔
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 4. BANNER LAYANAN DARURAT & JEMPUT BOLA LANGSUNG -->
    <section
      aria-label="Panggilan Darurat Administrasi Kependudukan"
      class="rounded-3xl p-6 sm:p-8 border-2 transition-colors relative overflow-hidden"
      :class="temaDisabilitas === 'netra-kontras' ? 'bg-black border-[#FACC15] text-[#FACC15]' : 'bg-gradient-to-r from-blue-900 to-indigo-950 text-white border-blue-900'"
    >
      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black" :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black' : 'bg-white/10 text-white border border-white/20'">
