  </div>

  <!-- Script Alpine.js untuk State Beranda & Web Speech Audio Guide -->
  <script is:inline>
    function homePage() {
      return {
        quickNik: '',
        isSpeaking: false,

        toggleAudioGuide() {
          if (!('speechSynthesis' in window)) {
            alert('Fitur pembaca suara tidak didukung pada peramban ini.');
            return;
          }

          if (this.isSpeaking) {
            window.speechSynthesis.cancel();
            this.isSpeaking = false;
            return;
          }

          window.speechSynthesis.cancel();
          const narasi = `Selamat datang di portal KITA-KTP, Kependudukan Inklusif, Tangkas dan Aksesibel. 
Portal ini menjamin hak identitas kependudukan yang setara untuk seluruh warga tanpa diskriminasi. 
Tersedia tiga pintu layanan utama: 
Pintu pertama, Layanan Warga Lansia untuk warga usia 60 tahun ke atas dengan fasilitas jemput bola petugas rekam biometrik ke rumah dan bebas antrean berdiri. 
Pintu kedua, Layanan Penyandang Disabilitas dengan fasilitas aksesibilitas penuh, formulir audio mandiri, juru bahasa isyarat, dan perekaman khusus ke kediaman. 
Pintu ketiga, Layanan Masyarakat Umum untuk pendaftaran antrean digital mandiri di kantor kecamatan. 
Alur layanan terdiri dari empat langkah mudah: pilih kategori, lengkapi data NIK dan alamat, verifikasi petugas, dan KTP siap diterima langsung di rumah atau di kantor kecamatan. 
Jika Anda sudah pernah mendaftar, gunakan kolom pelacakan di bagian bawah untuk memeriksa status penerbitan KTP Anda secara langsung.`;

          const utterance = new SpeechSynthesisUtterance(narasi);
          utterance.lang = 'id-ID';
          utterance.rate = 0.95;
          utterance.pitch = 1.0;

          // Coba cari suara bahasa Indonesia jika tersedia
          const voices = window.speechSynthesis.getVoices();
          const idVoice = voices.find(v => v.lang.includes('id') || v.lang.includes('ID'));
          if (idVoice) utterance.voice = idVoice;

          utterance.onstart = () => { this.isSpeaking = true; };
          utterance.onend = () => { this.isSpeaking = false; };
          utterance.onerror = () => { this.isSpeaking = false; };

          window.speechSynthesis.speak(utterance);
        },

        handleQuickSearch() {
          const q = this.quickNik.trim();
          if (!q) {
            window.location.href = '/lacak';
            return;
          }
          this.goToTracking(q);
        },

        goToTracking(code) {
          if (typeof this.playClick === 'function') {
            this.playClick();
          }
          window.location.href = '/lacak?q=' + encodeURIComponent(code);
        }
      };
    }
  </script>
</MainLayout>
