---
import MainLayout from '../layouts/MainLayout.astro';

const priorityGates = [
  {
    id: 'lansia',
    badge: 'Armada Keliling Gratis',
    badgeClass: 'bg-amber-100 text-amber-950 border-amber-300',
    title: 'Gerbang Prioritas Lansia',
    subtitle: 'Warga Usia 60 Tahun ke Atas',
    desc: 'Fasilitas jemput bola ke kediaman tanpa perlu antre di kantor dinas. Tim Dukcapil hadir membawa alat perekaman biometrik khusus warga tirah baring.',
    icon: '🧓',
    link: '/layanan/lansia',
    cta: 'Panggil Petugas Lansia ➔',
    borderClass: 'border-amber-200 hover:border-amber-400 bg-amber-50/50'
  },
  {
    id: 'disabilitas',
    badge: 'Aksesibel & Sensorik',
    badgeClass: 'bg-purple-100 text-purple-950 border-purple-300',
    title: 'Gerbang Khusus Disabilitas',
    subtitle: 'Sensorik, Fisik, Intelektual & Mental',
    desc: 'Dukungan formulir suara (TTS), pendampingan juru bahasa isyarat, dan armada jemput bola perekaman sidik jari & iris mata langsung ke panti sosial atau rumah.',
    icon: '♿',
    link: '/layanan/disabilitas',
    cta: 'Daftar Layanan Disabilitas ➔',
    borderClass: 'border-purple-200 hover:border-purple-400 bg-purple-50/50'
  },
  {
    id: 'umum',
    badge: 'Tiket Antrean Mandiri',
    badgeClass: 'bg-blue-100 text-blue-950 border-blue-300',
    title: 'Gerbang Mandiri & Umum',
    subtitle: 'Seluruh Warga Negara Indonesia',
    desc: 'Registrasi online mandiri, pemesanan tiket antrean loket kecamatan tanpa calo, penelusuran berkas instan, dan estimasi waktu tunggu transparan.',
    icon: '🏢',
    link: '/layanan/ktp',
    cta: 'Buka Loket Mandiri ➔',
    borderClass: 'border-blue-200 hover:border-blue-400 bg-blue-50/50'
  }
];

const directoryServices = [
  {
    slug: 'ktp',
    icon: '🪪',
    title: 'KTP-el / Identitas',
    category: 'Identitas Pokok',
    badge: 'Jemput Bola & Loket',
    badgeColor: 'bg-blue-50 text-blue-800 border-blue-200',
    desc: 'Perekaman pemula 17 tahun, penggantian fisik rusak/hilang, dan pembaruan biometrik.',
    sla: '1-2 Hari Kerja'
  },
  {
    slug: 'kk',
    icon: '👨‍👩‍👧',
    title: 'Kartu Keluarga (KK)',
    category: 'Data Keluarga',
    badge: 'Online & Cetak Mandiri',
    badgeColor: 'bg-indigo-50 text-indigo-800 border-indigo-200',
    desc: 'Pecah KK baru, penambahan anggota keluarga, dan pemutakhiran biodata sipil.',
    sla: '1 Hari Kerja'
  },
  {
    slug: 'kia',
    icon: '👶',
    title: 'KIA / Identitas Anak',
    category: 'Hak Sipil Anak',
    badge: 'Online & Kurir Dinas',
    badgeColor: 'bg-pink-50 text-pink-800 border-pink-200',
    desc: 'Penerbitan kartu identitas anak usia 0-17 tahun terintegrasi kutipan akta kelahiran.',
    sla: '2 Hari Kerja'
  },
  {
    slug: 'bpjs',
    icon: '🏥',
    title: 'BPJS Kesehatan',
    category: 'Jaminan Sosial',
    badge: 'Sinkronisasi NIK PBI',
    badgeColor: 'bg-emerald-50 text-emerald-800 border-emerald-200',
    desc: 'Sinkronisasi NIK kepesertaan PBI bantuan pemerintah dan pindah faskes tingkat 1.',
    sla: 'Instan / 24 Jam'
  },
  {
    slug: 'bansos',
    icon: '💰',
    title: 'Bantuan Sosial (Bansos)',
    category: 'Bansos & DTKS',
    badge: 'Cek Desil & Usulan',
    badgeColor: 'bg-amber-50 text-amber-800 border-amber-200',
    desc: 'Pengecekan desil kemiskinan DTKS, usulan sembako PKH, dan validasi lapangan dinas sosial.',
    sla: '3 Hari Kerja'
  },
  {
    slug: 'disabilitas',
    icon: '♿',
    title: 'Layanan Disabilitas',
    category: 'Inklusi Prioritas',
    badge: 'Jemput Bola Prioritas',
    badgeColor: 'bg-purple-50 text-purple-800 border-purple-200',
    desc: 'Pendampingan sensorik netra/rungu, juru bahasa isyarat, dan jemput bola ke rumah.',
    sla: 'Prioritas Utama'
  },
  {
    slug: 'lansia',
    icon: '🧓',
    title: 'Layanan Lansia',
    category: 'Prioritas Usia 60+',
    badge: 'Armada Khusus Rumah',
    badgeColor: 'bg-orange-50 text-orange-800 border-orange-200',
    desc: 'Percepatan cetak KTP seumur hidup dan armada keliling jemput bola ke kediaman.',
    sla: 'Prioritas Utama'
  },
  {
    slug: 'domisili',
    icon: '🏠',
    title: 'Pindah Domisili',
    category: 'Mobilitas Warga',
    badge: 'SKPWNI Digital',
    badgeColor: 'bg-teal-50 text-teal-800 border-teal-200',
    desc: 'Penerbitan Surat Keterangan Pindah Warga Negara Indonesia (SKPWNI) antar daerah.',
    sla: '1-2 Hari Kerja'
  },
  {
    slug: 'akta',
    icon: '📄',
    title: 'Akta Lahir & Kematian',
    category: 'Catatan Sipil',
    badge: 'QR Code Resmi',
    badgeColor: 'bg-cyan-50 text-cyan-800 border-cyan-200',
    desc: 'Pencatatan dan penerbitan kutipan akta kelahiran baru serta akta kematian keluarga.',
    sla: '2 Hari Kerja'
  },
  {
    slug: 'pendatang',
    icon: '🗺️',
    title: 'Panduan Warga Pindah',
    category: 'Integrasi Warga',
    badge: 'Integrasi RT/RW',
    badgeColor: 'bg-sky-50 text-sky-800 border-sky-200',
    desc: 'Ceklist administrasi lapor RT/RW 1x24 jam dan pendaftaran domisili tempat tinggal.',
    sla: '1 Hari Kerja'
  },
  {
    slug: 'laporan',
    icon: '📢',
    title: 'Pengaduan & Laporan',
    category: 'Transparansi Publik',
    badge: 'Respons 1x24 Jam',
    badgeColor: 'bg-rose-50 text-rose-800 border-rose-200',
    desc: 'Saluran pengaduan pungli, kendala sidik jari biometrik, dan keluhan administrasi.',
    sla: 'Maks. 24 Jam'
  }
];
---

<MainLayout
  title="KITA-TERPADU — Direktori Layanan Administrasi Kependudukan Inklusif"
  description="Layanan Kependudukan dan Catatan Sipil Terpadu Ramah Disabilitas, Lansia, dan Warga Umum."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-14 sm:space-y-20 w-full max-w-full overflow-x-hidden" x-data="{ isSpeakingHero: false }">

    <!-- 1. HERO SECTION UNIVERSAL (1 Kolom di HP, 2 Kolom di Desktop) -->
    <section aria-labelledby="hero-main-title" class="w-full max-w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Kolom Kiri: Teks & Aksi -->
        <div class="lg:col-span-7 space-y-5 text-left">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black border transition-all"
            :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-blue-200 bg-blue-50 text-blue-950 shadow-2xs'"
          >
            <span>🇮🇩</span>
            <span class="tracking-wide uppercase text-[10px] sm:text-xs">KITA-TERPADU — Sistem Administrasi Kependudukan & Layanan Publik Inklusif</span>
          </div>

          <h1
            id="hero-main-title"
            class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-[1.2]"
            :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'"
          >
            Kesetaraan Hak Kependudukan Tanpa Batas Ruang dan Kondisi Fisik
          </h1>

          <p
            class="text-xs sm:text-sm lg:text-base font-medium leading-relaxed max-w-2xl text-slate-600"
            :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/90' : ''"
          >
            Pelayanan administrasi kependudukan yang <strong>100% bebas biaya</strong>, transparan, dan berkeadilan. Warga berhak atas penerbitan dokumen hukum secara mandiri maupun melalui <strong>armada jemput bola</strong> langsung ke rumah khusus lansia dan penyandang disabilitas.
          </p>

          <!-- Action Buttons & Audio Guide -->
          <div class="pt-2 flex flex-wrap items-center gap-2.5 sm:gap-3">
            <button
              type="button"
              @click="
                bunyiKlik(650);
                if (isSpeakingHero) {
                  hentikanSuara();
                  isSpeakingHero = false;
                } else {
                  isSpeakingHero = true;
                  bacaPanduan('Selamat datang di Portal KITA-TERPADU Republik Indonesia. Portal ini menjamin kemudahan akses administrasi kependudukan bebas biaya bagi seluruh warga negara, didukung layanan jemput bola ke rumah bagi lansia dan difabel.');
                }
              "
              class="px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-black border-2 transition-all flex items-center gap-2 cursor-pointer shadow-xs active:scale-95"
              :class="isSpeakingHero
                ? (temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-amber-400 text-slate-950 border-amber-500 animate-pulse')
                : (temaDisabilitas === 'netra-kontras' ? 'bg-black text-[#FACC15] border-[#FACC15]' : 'bg-white text-slate-800 border-slate-300 hover:bg-slate-100')"
            >
              <span class="text-base" x-text="isSpeakingHero ? '⏹️' : '🔊'"></span>
              <span x-text="isSpeakingHero ? 'Hentikan Suara' : 'Dengar Ringkasan Audio'"></span>
            </button>

            <a
              href="#modul-layanan"
              @click="bunyiKlik(650)"
              class="px-4 sm:px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-black border transition-all flex items-center gap-1.5 shadow-xs active:scale-95"
              :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-blue-600 text-white border-blue-600 hover:bg-blue-700'"
            >
              <span>11 Layanan</span>
              <span aria-hidden="true">↓</span>
            </a>

            <a
              href="/lacak"
              @click="bunyiKlik(700)"
              class="px-4 sm:px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-black border transition-all flex items-center gap-1.5 shadow-xs active:scale-95"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] text-[#FACC15]' : 'bg-slate-900 text-white border-slate-900 hover:bg-slate-800'"
            >
              <span>🔍 Lacak Tiket</span>
            </a>
          </div>
        </div>

        <!-- Kolom Kanan: Foto Hero Editorial Berkualitas Tinggi -->
        <div class="lg:col-span-5 relative w-full">
          <div
            class="relative rounded-3xl overflow-hidden border-2 shadow-xl"
            :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black' : 'border-slate-200 bg-white'"
          >
            <img
              src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=1000&auto=format&fit=crop"
              alt="Petugas pelayanan kependudukan melayani warga lansia dengan ramah dan inklusif"
              class="w-full h-64 sm:h-80 lg:h-96 object-cover object-center"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-3 left-3 right-3 text-white">
              <span class="inline-block text-[9px] font-black uppercase tracking-wider bg-blue-600 px-2.5 py-0.5 rounded-full mb-1">
                Layanan Jemput Bola Terpadu
              </span>
              <p class="text-xs font-bold leading-snug drop-shadow-sm">
                Petugas Dukcapil hadir ke rumah warga lansia dan difabel untuk perekaman data biometrik.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. TIGA GERBANG PRIORITAS KHUSUS -->
    <section aria-labelledby="gerbang-title" class="space-y-5 w-full max-w-full">
      <div class="text-left space-y-1">
        <h2
          id="gerbang-title"
          class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight"
          :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'"
        >
          Tiga Gerbang Prioritas Pelayanan
        </h2>
        <p class="text-xs sm:text-sm font-semibold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
          Pilih jalur pelayanan sesuai kondisi fisik dan kebutuhan Anda
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
        {priorityGates.map((gate) => (
          <div
            class={`relative rounded-3xl p-5 sm:p-6 border-2 transition-all duration-200 hover:-translate-y-1 shadow-xs flex flex-col justify-between ${gate.borderClass}`}
            :class="temaDisabilitas === 'netra-kontras' ? 'bg-black! border-[#FACC15]! text-[#FACC15]!' : ''"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="w-12 h-12 rounded-2xl bg-white shadow-2xs border border-slate-200 flex items-center justify-center text-2xl shrink-0" :class="temaDisabilitas === 'netra-kontras' ? 'bg-neutral-900! border-[#FACC15]!' : ''">
                  {gate.icon}
                </span>
                <span class={`text-[9px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full border ${gate.badgeClass}`} :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15]! text-black! border-[#FACC15]!' : ''">
                  {gate.badge}
                </span>
              </div>

              <div>
                <h3 class="text-base sm:text-lg font-black tracking-tight" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'">
                  {gate.title}
                </h3>
                <span class="block text-xs font-bold text-slate-500 mt-0.5" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
                  {gate.subtitle}
                </span>
              </div>

              <p class="text-xs font-medium leading-relaxed" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/90' : 'text-slate-600'">
                {gate.desc}
              </p>
            </div>

            <div class="pt-5">
              <a
                href={gate.link}
                class="w-full py-2.5 px-4 rounded-xl text-xs font-black border transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-xs active:scale-95"
                :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300' : 'bg-slate-900 text-white border-slate-900 hover:bg-slate-800'"
              >
                <span>{gate.cta}</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. DIREKTORI 11 MODUL LAYANAN TERPADU -->
    <section id="modul-layanan" aria-labelledby="modul-title" class="space-y-5 pt-2 w-full max-w-full">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-3 border-b" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40' : 'border-slate-200'">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-wider text-blue-600" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : ''">
            Katalog Pelayanan Nasional
          </span>
          <h2
            id="modul-title"
            class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight"
            :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'"
          >
            Direktori 11 Modul Layanan Kependudukan
          </h2>
          <p class="text-xs sm:text-sm font-semibold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
            Pilih layanan untuk membuka formulir adaptif (Umum, Lansia, atau Disabilitas)
          </p>
        </div>

        <span
          class="inline-block px-3 py-1 rounded-full text-xs font-black border self-start sm:self-auto"
          :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-slate-300 bg-slate-100 text-slate-800'"
        >
          11 Layanan Aktif
        </span>
      </div>

      <!-- Responsive Card Grid: 1 kol di HP kecil, 2 di tablet, 3-4 di desktop -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5 sm:gap-4 w-full">
        {directoryServices.map((srv) => (
          <a
            href={`/layanan/${srv.slug}`}
            class="group relative rounded-3xl p-4 sm:p-5 border-2 transition-all duration-200 hover:-translate-y-1 flex flex-col justify-between shadow-xs hover:shadow-lg focus:outline-none focus:ring-4 cursor-pointer"
            :class="temaDisabilitas === 'netra-kontras'
              ? 'border-[#FACC15] bg-black text-[#FACC15] hover:bg-neutral-900 focus:ring-white'
              : 'border-slate-200 bg-white hover:border-blue-400 focus:ring-blue-300'"
            aria-label={`Buka pengajuan ${srv.title}`}
          >
            <div class="space-y-2.5">
              <div class="flex items-start justify-between gap-2">
                <span
                  class="w-11 h-11 rounded-2xl flex items-center justify-center text-2xl border shadow-2xs transition-transform duration-200 group-hover:scale-105 shrink-0"
                  :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-slate-50 border-slate-200'"
                  aria-hidden="true"
                >
                  {srv.icon}
                </span>

                <span
                  class={`text-[9px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full border ${srv.badgeColor}`}
                  :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15]! text-black! border-[#FACC15]!' : ''"
                >
                  {srv.badge}
                </span>
              </div>

              <div>
                <span class="block text-[10px] font-black uppercase tracking-wider text-slate-400" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/70' : ''">
                  {srv.category}
                </span>
                <h3 class="text-sm sm:text-base font-black tracking-tight leading-snug group-hover:text-blue-600 transition-colors" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15] group-hover:text-yellow-300' : 'text-slate-900'">
                  {srv.title}
                </h3>
              </div>

              <p class="text-xs font-medium leading-relaxed line-clamp-3 text-slate-600" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/90' : ''">
                {srv.desc}
              </p>
            </div>

            <div class="pt-3 mt-3 border-t flex items-center justify-between gap-2 text-xs font-bold" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/30' : 'border-slate-100'">
              <span class="text-[11px] text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
                ⏱️ {srv.sla}
              </span>
              <span class="text-blue-600 font-black group-hover:translate-x-1 transition-transform inline-flex items-center gap-1" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : ''">
                Buka Form ➔
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</MainLayout>
