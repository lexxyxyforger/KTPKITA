          :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-neutral-900 text-[#FACC15]' : 'border-purple-400/50 bg-purple-950/40 text-purple-300'"
        >
          KITA-2026-5419 (Disabilitas)
        </button>
        <button
          type="button"
          @click="goToTracking('KITA-2026-3104')"
          class="px-2.5 py-1 rounded-lg border font-mono font-bold text-xs hover:underline cursor-pointer"
          :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-neutral-900 text-[#FACC15]' : 'border-blue-400/50 bg-blue-950/40 text-blue-300'"
