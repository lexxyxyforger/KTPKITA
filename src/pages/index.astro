          >
            <span>Lacak Dokumen</span>
            <span aria-hidden="true">➔</span>
          </button>
        </div>
      </form>

      <!-- Shortcut Demo Instan -->
      <div class="pt-2 border-t border-slate-700/60 flex flex-wrap items-center gap-2 text-xs font-semibold">
        <span class="opacity-80">Uji Coba Data Demo:</span>
        <button
