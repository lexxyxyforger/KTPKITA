---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Layanan Khusus Lansia - KITA-KTP" description="Perekaman KTP Khusus Lansia: Petugas datang langsung ke rumah Anda.">
  <div x-data="lansiaPage()" class="w-full max-w-xl mx-auto space-y-6 px-1 sm:px-2">

    <!-- Top Bar: Navigasi Cepat & Tombol Panduan Audio -->
    <div class="flex items-center justify-between gap-2">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 font-bold text-xs sm:text-sm transition-colors focus:ring-2 rounded-lg px-2 py-1"
        :class="colorFilter === 'high-contrast' ? 'text-[#FACC15] hover:underline' : 'text-slate-600 hover:text-amber-800'"
      >
        <span aria-hidden="true">⬅</span>
        <span>Beranda</span>
      </a>

      <!-- Narasi Otomatis via Web Speech API -->
      <button
        type="button"
        @click="playAudioGuide()"
        class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black border-2 transition-all inline-flex items-center gap-1.5 cursor-pointer shadow-sm focus:ring-4 shrink-0 active:scale-95"
        :class="[
          isSpeaking
            ? (colorFilter === 'high-contrast' ? 'bg-amber-400 text-black border-amber-300 animate-pulse' : 'bg-red-600 text-white border-red-500 animate-pulse')
            : (colorFilter === 'high-contrast' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300' : 'bg-amber-500 text-slate-950 border-amber-600 hover:bg-amber-400')
        ]"
        aria-label="Dengarkan panduan suara halaman lansia"
      >
        <span aria-hidden="true" class="text-base">🔊</span>
        <span x-text="isSpeaking ? 'Hentikan Suara' : 'Dengarkan Panduan Suara'"></span>
      </button>
    </div>

    <!-- 1. HERO SECTION: Visual-Heavy & Foto Lansia Indonesia/Asia Berkualitas Tinggi -->
    <section
      aria-labelledby="hero-lansia-title"
      class="rounded-3xl border-2 overflow-hidden transition-all shadow-md"
      :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-amber-300 bg-white'"
    >
      <!-- Foto Hero Lansia Bersama Petugas -->
      <div class="relative w-full h-52 sm:h-64 overflow-hidden bg-slate-100">
        <img
          src="https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?auto=format&fit=crop&w=800&q=80"
          alt="Foto lansia tersenyum bahagia didampingi petugas ramah kependudukan"
          loading="eager"
          class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
        />
        <div class="absolute top-3 left-3">
          <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider shadow-md border"
            :class="colorFilter === 'high-contrast' ? 'bg-black text-[#FACC15] border-[#FACC15]' : 'bg-amber-500 text-slate-950 border-amber-600'"
          >
            ★ Prioritas Lansia
          </span>
        </div>
      </div>

      <!-- Hero Text (Font Besar & Mudah Dibaca) -->
      <div class="p-5 sm:p-7 text-center space-y-2">
        <h1 id="hero-lansia-title" class="text-2xl sm:text-3xl font-black tracking-tight leading-snug">
          Petugas Rekam KTP Datang ke Rumah Anda
        </h1>
        <p class="text-base sm:text-lg font-bold leading-relaxed" :class="colorFilter === 'high-contrast' ? 'text-[#FACC15]/90' : 'text-slate-700'">
          Bapak dan Ibu tidak perlu antre ke kantor. Cukup tuliskan nama dan alamat, petugas kami akan datang membawa alat rekam biometrik.
        </p>
      </div>
    </section>

    <!-- 2. 3 KARTU LANGKAH MUDAH BERGAMBAR (Visual Guide) -->
    <section aria-label="3 Langkah Mudah Pelayanan Lansia" class="space-y-3">
      <h2 class="text-lg sm:text-xl font-black px-1 flex items-center gap-2">
        <span>3 Langkah Mudah Jemput Bola:</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Kartu 1: Tunggu di Rumah -->
        <div
          class="rounded-2xl border-2 overflow-hidden flex flex-col justify-between transition-all"
          :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-amber-200 bg-white shadow-xs'"
        >
          <div class="h-32 sm:h-28 overflow-hidden bg-slate-100">
            <img
              src="https://images.unsplash.com/photo-1581579438747-1dc8d17bbce4?auto=format&fit=crop&w=600&q=80"
              alt="Lansia sedang santai duduk di rumah"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="p-3 text-center">
            <span class="block text-sm sm:text-base font-black">1. Tunggu di Rumah</span>
            <span class="block text-xs font-semibold text-slate-500 mt-0.5" :class="colorFilter === 'high-contrast' ? 'text-[#FACC15]/80' : ''">
              Santai tanpa perlu bepergian
            </span>
          </div>
        </div>

        <!-- Kartu 2: Petugas Datang -->
        <div
          class="rounded-2xl border-2 overflow-hidden flex flex-col justify-between transition-all"
          :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-amber-200 bg-white shadow-xs'"
        >
          <div class="h-32 sm:h-28 overflow-hidden bg-slate-100">
            <img
              src="https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=600&q=80"
              alt="Petugas membawa perlengkapan foto dan sidik jari portabel"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="p-3 text-center">
            <span class="block text-sm sm:text-base font-black">2. Petugas Datang</span>
            <span class="block text-xs font-semibold text-slate-500 mt-0.5" :class="colorFilter === 'high-contrast' ? 'text-[#FACC15]/80' : ''">
              Rekam foto & sidik jari di tempat
            </span>
          </div>
        </div>

        <!-- Kartu 3: KTP Selesai -->
        <div
          class="rounded-2xl border-2 overflow-hidden flex flex-col justify-between transition-all"
          :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-amber-200 bg-white shadow-xs'"
        >
          <div class="h-32 sm:h-28 overflow-hidden bg-slate-100">
            <img
              src="https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&w=600&q=80"
              alt="Penyerahan kartu tanda penduduk selesai"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="p-3 text-center">
            <span class="block text-sm sm:text-base font-black">3. KTP Selesai</span>
            <span class="block text-xs font-semibold text-slate-500 mt-0.5" :class="colorFilter === 'high-contrast' ? 'text-[#FACC15]/80' : ''">
              KTP diantar gratis ke tangan Anda
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Success Feedback Banner -->
    <div
      x-show="isSuccess"
      x-transition
      role="alert"
      class="rounded-3xl p-6 sm:p-8 border-2 text-center space-y-4 shadow-xl"
      :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-neutral-950 text-[#FACC15]' : 'border-emerald-400 bg-emerald-50 text-emerald-950'"
    >
      <div class="w-16 h-16 mx-auto rounded-full flex items-center justify-center text-3xl font-black"
        :class="colorFilter === 'high-contrast' ? 'bg-[#FACC15] text-black' : 'bg-emerald-600 text-white'"
        aria-hidden="true"
      >
        ✓
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl font-black">Permohonan Berhasil!</h2>
        <p class="text-base font-bold mt-1">Petugas layanan keliling akan segera menuju ke alamat Bapak / Ibu.</p>
      </div>

      <div class="p-4 rounded-2xl border font-mono text-center inline-block"
        :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-emerald-300 bg-white text-emerald-900 shadow-inner'"
      >
        <span class="block text-xs uppercase font-black">Nomor Registrasi Lansia:</span>
        <span class="block text-2xl font-black tracking-widest mt-1" x-text="savedReg"></span>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/lacak"
          class="w-full sm:w-auto px-6 py-3.5 rounded-2xl font-black text-base border transition-all text-center focus:ring-4 cursor-pointer"
          :class="colorFilter === 'high-contrast' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-emerald-700 text-white border-emerald-700 hover:bg-emerald-800 shadow-md'"
        >
          Lihat Status Pengajuan ➔
        </a>
        <button
          type="button"
          @click="isSuccess = false"
          class="w-full sm:w-auto px-4 py-3 rounded-xl font-bold text-xs text-center hover:underline cursor-pointer"
          :class="colorFilter === 'high-contrast' ? 'text-[#FACC15]' : 'text-slate-600'"
        >
          Daftarkan Lansia Lainnya
        </button>
      </div>
    </div>

    <!-- 3. FORM SUPER SIMPEL (Font Besar Minimal 18px & Tombol Submit Kuning/Oranye) -->
    <div
      x-show="!isSuccess"
      class="rounded-3xl p-5 sm:p-7 border-2 transition-all shadow-md"
      :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black' : 'border-amber-300 bg-white'"
    >
      <div class="mb-5 pb-3 border-b text-center" :class="colorFilter === 'high-contrast' ? 'border-[#FACC15]/40' : 'border-slate-200'">
        <h2 class="text-xl sm:text-2xl font-black">Formulir Panggil Petugas</h2>
        <p class="text-xs sm:text-sm font-semibold text-slate-500 mt-1" :class="colorFilter === 'high-contrast' ? 'text-[#FACC15]/80' : ''">
          Hanya perlu 2 data utama di bawah ini:
        </p>
      </div>

      <form @submit.prevent="submitLansia()" class="space-y-5" novalidate>
        <!-- Field 1: Nama Lengkap Lansia (Font Besar 18px) -->
        <div class="space-y-1.5">
          <label for="lansia-nama" class="block text-lg font-black flex items-center gap-1.5">
            <span>👤 Nama Lengkap Lansia</span>
            <span class="text-red-500 font-bold" aria-hidden="true">*</span>
          </label>
          <input
            id="lansia-nama"
            type="text"
            x-model="nama"
            placeholder="Contoh: Kakek Sukardi"
            required
            class="w-full px-4 py-3.5 sm:py-4 rounded-2xl border-2 text-lg font-bold transition-colors focus:ring-4 focus:outline-none"
            :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-[#FACC15]' : 'border-slate-300 bg-white focus:border-amber-500 focus:ring-amber-300'"
          />
        </div>

        <!-- Field 2: Alamat Rumah Lengkap (Font Besar) -->
        <div class="space-y-1.5">
          <label for="lansia-alamat" class="block text-lg font-black flex items-center gap-1.5">
            <span>🏠 Alamat Rumah Lengkap</span>
            <span class="text-red-500 font-bold" aria-hidden="true">*</span>
          </label>
          <textarea
            id="lansia-alamat"
            rows="3"
            x-model="alamat"
            placeholder="Nama jalan, nomor rumah, RT/RW, dan patokan rumah..."
            required
            class="w-full px-4 py-3.5 rounded-2xl border-2 text-base sm:text-lg font-bold transition-colors focus:ring-4 focus:outline-none"
            :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-[#FACC15]' : 'border-slate-300 bg-white focus:border-amber-500 focus:ring-amber-300'"
          ></textarea>
        </div>

        <!-- Optional: Nomor Telepon Pendamping -->
        <div class="space-y-1">
          <label for="lansia-telepon" class="block text-xs sm:text-sm font-extrabold text-slate-700" :class="colorFilter === 'high-contrast' ? 'text-[#FACC15]!' : ''">
            📞 Nomor HP / WhatsApp Anak atau Pendamping (Opsional):
          </label>
          <input
            id="lansia-telepon"
            type="tel"
            x-model="telepon"
            placeholder="Contoh: 08123456789"
            class="w-full px-4 py-3 rounded-xl border text-sm sm:text-base font-bold transition-colors focus:ring-4 focus:outline-none"
            :class="colorFilter === 'high-contrast' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-[#FACC15]' : 'border-slate-300 bg-white focus:border-amber-500 focus:ring-amber-300'"
          />
        </div>

        <!-- Tombol Submit Kuning/Oranye Kontras Tinggi -->
        <div class="pt-2">
          <button
            type="submit"
            class="w-full py-4 sm:py-5 px-6 rounded-2xl font-black text-lg sm:text-xl border-2 transition-all focus:ring-4 flex items-center justify-center gap-3 cursor-pointer shadow-lg active:scale-98"
            :class="colorFilter === 'high-contrast' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300 focus:ring-white' : 'bg-amber-500 text-slate-950 border-amber-600 hover:bg-amber-400 focus:ring-amber-300'"
          >
            <span>Panggil Petugas ke Rumah Sekarang</span>
            <span aria-hidden="true" class="text-2xl">➔</span>
          </button>
        </div>
      </form>
    </div>

  </div>

  <script is:inline>
    function lansiaPage() {
      return {
        nama: '',
        alamat: '',
        telepon: '',
        isSuccess: false,
        savedReg: '',
        isSpeaking: false,

        // Narasi Otomatis via Web Speech API
        playAudioGuide() {
          if (!('speechSynthesis' in window)) {
            alert('Peramban Anda belum mendukung fitur pembaca suara.');
            return;
          }

          if (this.isSpeaking) {
            window.speechSynthesis.cancel();
            this.isSpeaking = false;
            return;
          }

          window.speechSynthesis.cancel();
          const narasi = 'Halaman Layanan Khusus Lansia KITA-KTP. Petugas perekaman biometrik KTP siap datang langsung ke kediaman Bapak dan Ibu. Cukup isi dua kolom: ketik Nama Lengkap dan Alamat Rumah Anda, lalu tekan tombol kuning bertuliskan Panggil Petugas ke Rumah Sekarang. Petugas kami akan segera datang.';
          const u = new SpeechSynthesisUtterance(narasi);
          u.lang = 'id-ID';
          u.rate = 0.95;

          const voices = window.speechSynthesis.getVoices();
          const idV = voices.find(v => v.lang === 'id-ID' || v.lang.startsWith('id'));
          if (idV) u.voice = idV;

          u.onstart = () => { this.isSpeaking = true; };
          u.onend = () => { this.isSpeaking = false; };
          u.onerror = () => { this.isSpeaking = false; };

          window.speechSynthesis.speak(u);
        },

        submitLansia() {
          if (!this.nama.trim() || !this.alamat.trim()) {
            alert('Mohon lengkapi Nama dan Alamat Rumah Anda.');
            return;
          }

          const reg = 'KITA-2026-' + Math.floor(1000 + Math.random() * 9000);
          const record = {
            id: reg,
            regNumber: reg,
            nik: '3201LANSIA' + Math.floor(100000 + Math.random() * 900000),
            nama: this.nama,
            kategori: 'Lansia',
            kebutuhan: 'Prioritas Lansia - Layanan Jemput Bola',
            alamat: this.alamat,
            telepon: this.telepon || '-',
            createdAt: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) + ' WIB',
            step: 1,
            statusTitle: 'Permohonan Kunjungan Petugas Diterima',
            statusMessage: 'Data telah dijadwalkan ke unit keliling jemput bola. Petugas akan menghubungi sebelum kedatangan.',
            estimasi: '1 Hari Kerja'
          };

          const KEY = 'kita_ktp_records';
          let records = [];
          try { records = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { records = []; }
          records.unshift(record);
          localStorage.setItem(KEY, JSON.stringify(records));

          this.savedReg = reg;
          this.isSuccess = true;

          // Vocal Confirmation
          if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            const voiceConfirm = new SpeechSynthesisUtterance('Pendaftaran berhasil. Petugas akan datang ke rumah Anda. Nomor registrasi Anda adalah ' + reg.replace(/-/g, ' '));
            voiceConfirm.lang = 'id-ID';
            window.speechSynthesis.speak(voiceConfirm);
          }
        }
      };
    }
  </script>
</MainLayout>
