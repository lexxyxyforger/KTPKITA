---
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const services = [
    {
      slug: 'ktp',
      nama: 'KTP-el / Identitas Kependudukan',
      kategori: 'Identitas Pokok',
      ikon: '🪪',
      deskripsi: 'Perekaman pemula 17 tahun, penggantian fisik rusak/hilang, dan pembaruan biometrik',
      foto: 'https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Perekaman KTP baru pemula 17 tahun atau penggantian fisik hilang'
    },
    {
      slug: 'kk',
      nama: 'Kartu Keluarga (KK)',
      kategori: 'Data Keluarga',
      ikon: '👨‍👩‍👧',
      deskripsi: 'Pecah KK baru, penambahan anggota keluarga, dan perubahan biodata sipil',
      foto: 'https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Pemecahan KK karena pernikahan atau penambahan anggota keluarga baru'
    },
    {
      slug: 'kia',
      nama: 'KIA / Identitas Anak',
      kategori: 'Identitas Anak',
      ikon: '👶',
      deskripsi: 'Penerbitan kartu identitas usia 0-17 tahun terintegrasi kutipan akta kelahiran',
      foto: 'https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Penerbitan KIA anak usia 5 tahun dan pencetakan kutipan akta kelahiran'
    },
    {
      slug: 'bpjs',
      nama: 'BPJS Kesehatan',
      kategori: 'Jaminan Kesehatan',
      ikon: '🏥',
      deskripsi: 'Sinkronisasi NIK kepesertaan PBI bantuan pemerintah dan pindah faskes tingkat 1',
      foto: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Pendaftaran peserta PBI bantuan pemerintah atau pindah puskesmas terdekat'
    },
    {
      slug: 'bansos',
      nama: 'Bantuan Sosial (Bansos)',
      kategori: 'Bantuan Sosial',
      ikon: '💰',
      deskripsi: 'Pengecekan desil kemiskinan DTKS, usulan sembako PKH, dan validasi dinas sosial',
      foto: 'https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Pengecekan status desil DTKS dan usulan bantuan sosial sembako PKH'
    },
    {
      slug: 'disabilitas',
      nama: 'Layanan Khusus Disabilitas',
      kategori: 'Akses Prioritas',
      ikon: '♿',
      deskripsi: 'Pendampingan sensorik netra/rungu, juru bahasa isyarat, dan jemput bola ke rumah',
      foto: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Permohonan pendampingan juru bahasa isyarat atau jemput bola kursi roda'
    },
    {
      slug: 'lansia',
      nama: 'Layanan Prioritas Lansia',
      kategori: 'Prioritas Usia 60+',
      ikon: '🧓',
      deskripsi: 'Percepatan rekam dokumen kependudukan dan armada keliling jemput bola ke kediaman',
      foto: 'https://images.unsplash.com/photo-1581579438747-1dc8d17bbce4?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Layanan rekam biometrik jemput bola ke rumah bagi warga lansia usia 75 tahun'
    },
    {
      slug: 'domisili',
      nama: 'Surat Pindah Domisili',
      kategori: 'Mobilitas Warga',
      ikon: '🏠',
      deskripsi: 'Penerbitan SKPWNI antar RT, kelurahan, kecamatan, dan lintas provinsi',
      foto: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Penerbitan SKPWNI pindah domisili dari Jakarta ke Depok'
    },
    {
      slug: 'akta',
      nama: 'Akta Lahir & Kematian',
      kategori: 'Catatan Sipil',
      ikon: '📄',
      deskripsi: 'Pencatatan dan penerbitan kutipan akta kelahiran baru maupun akta kematian',
      foto: 'https://images.unsplash.com/photo-1450133064473-71024230f91b?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Pencatatan akta kelahiran anak baru atau penerbitan akta kematian keluarga'
    },
    {
      slug: 'pendatang',
      nama: 'Panduan Warga Baru Pindah',
      kategori: 'Integrasi Warga',
      ikon: '🗺️',
      deskripsi: 'Ceklist administrasi lapor RT/RW 1x24 jam dan pendaftaran domisili tempat tinggal',
      foto: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Ceklist administrasi lapor RT/RW 1x24 jam dan mutasi berkas kependudukan'
    },
    {
      slug: 'laporan',
      nama: 'Pengaduan & Laporan Warga',
      kategori: 'Transparansi Publik',
      ikon: '📢',
      deskripsi: 'Saluran pengaduan pungli, kendala sidik jari biometrik, dan keluhan administrasi',
      foto: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Laporan kendala perekaman biometrik sidik jari di loket kecamatan'
    },
    // Aliases
    {
      slug: 'pindah',
      nama: 'Surat Pindah Domisili',
      kategori: 'Mobilitas Warga',
      ikon: '🏠',
      deskripsi: 'Penerbitan SKPWNI antar RT, kelurahan, dan provinsi',
      foto: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Penerbitan SKPWNI pindah domisili'
    },
    {
      slug: 'panduan',
      nama: 'Panduan Warga Baru Pindah',
      kategori: 'Integrasi Warga',
      ikon: '🗺️',
      deskripsi: 'Ceklist administrasi lapor RT/RW 1x24 jam',
      foto: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Ceklist administrasi lapor RT/RW'
    },
    {
      slug: 'aduan',
      nama: 'Pengaduan & Laporan Warga',
      kategori: 'Transparansi Publik',
      ikon: '📢',
      deskripsi: 'Saluran pengaduan pungli dan kendala layanan',
      foto: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Laporan kendala administrasi'
    }
  ];

  return services.map((s) => ({
    params: { slug: s.slug },
    props: { service: s }
  }));
}

const { service } = Astro.props;
---

<MainLayout
  title={`${service.nama} — Portal KITA-KTP`}
  description={`Pengajuan formulir adaptif ${service.nama} dengan opsi umum, lansia jemput bola, dan disabilitas.`}
>
  <div
    class="max-w-4xl mx-auto space-y-8 pb-16"
    x-data={`formAdaptiveEngine('${service.nama}', '${service.slug}')`}
  >
    <!-- BREADCRUMB & HEADER -->
    <div class="space-y-3">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-bold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
        <a href="/" class="hover:underline flex items-center gap-1">
          <span>🏠</span>
          <span>Beranda</span>
        </a>
        <span>/</span>
        <span class="text-blue-600 font-extrabold" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : ''">{service.kategori}</span>
        <span>/</span>
        <span class="text-slate-800 truncate" :class="temaDisabilitas === 'netra-kontras' ? 'text-white' : ''">{service.nama}</span>
      </nav>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40' : 'border-slate-200'">
        <div class="flex items-center gap-3">
          <span class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl border shadow-sm shrink-0" :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-blue-50 text-blue-900 border-blue-200'">
            {service.ikon}
          </span>
          <div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'">
              {service.nama}
            </h1>
            <p class="text-xs sm:text-sm font-semibold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
              {service.deskripsi}
            </p>
          </div>
        </div>

        <div class="shrink-0">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-black border" :class="temaDisabilitas === 'netra-kontras' ? 'bg-black text-[#FACC15] border-[#FACC15]' : 'bg-emerald-50 text-emerald-800 border-emerald-200'">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>100% Bebas Biaya (Gratis)</span>
          </span>
        </div>
      </div>
    </div>

    <!-- FLOATING SEGMENTED CONTROLLER (SWITCHER 3 MODE) -->
    <div class="sticky top-20 z-30 pt-1">
      <div
        class="p-1.5 rounded-2xl border-2 backdrop-blur-md shadow-lg flex items-center justify-between gap-1.5 max-w-xl mx-auto"
        :class="temaDisabilitas === 'netra-kontras' ? 'bg-black border-[#FACC15]' : 'bg-white/95 border-slate-200 shadow-slate-200/50'"
        role="tablist"
        aria-label="Pilihan Mode Formulir"
      >
        <!-- Mode Umum -->
        <button
          type="button"
          @click="pilihMode('umum')"
          class="flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer flex items-center justify-center gap-1.5"
          :class="activeMode === 'umum'
            ? (temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black shadow-sm font-black' : 'bg-slate-900 text-white shadow-md')
            : (temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15] hover:bg-neutral-900' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100')"
          role="tab"
          :aria-selected="(activeMode === 'umum').toString()"
        >
          <span>👤</span>
          <span>Mode Umum</span>
        </button>

        <!-- Mode Lansia -->
        <button
          type="button"
          @click="pilihMode('lansia')"
          class="flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer flex items-center justify-center gap-1.5"
          :class="activeMode === 'lansia'
            ? (temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black shadow-sm font-black' : 'bg-amber-500 text-slate-950 shadow-md ring-2 ring-amber-300')
            : (temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15] hover:bg-neutral-900' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100')"
          role="tab"
          :aria-selected="(activeMode === 'lansia').toString()"
        >
          <span>🧓</span>
          <span>Mode Lansia</span>
        </button>

        <!-- Mode Disabilitas -->
        <button
          type="button"
          @click="pilihMode('disabilitas')"
          class="flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer flex items-center justify-center gap-1.5"
          :class="activeMode === 'disabilitas'
            ? (temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black shadow-sm font-black' : 'bg-purple-600 text-white shadow-md ring-2 ring-purple-300')
            : (temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15] hover:bg-neutral-900' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100')"
          role="tab"
          :aria-selected="(activeMode === 'disabilitas').toString()"
        >
          <span>♿</span>
          <span>Mode Disabilitas</span>
        </button>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- PENGALAMAN 1: TAMPILAN MODE UMUM -->
    <!-- ========================================== -->
    <div
      x-show="activeMode === 'umum'"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      class="space-y-6"
    >
      <div class="p-4 rounded-2xl border flex items-center justify-between gap-3 text-xs" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-blue-200 bg-blue-50 text-blue-900'">
        <div class="flex items-center gap-2">
          <span class="text-lg">🏢</span>
          <span class="font-bold">Pendaftaran Mandiri Loket Kecamatan & Pengantaran Berkas</span>
        </div>
        <span class="font-extrabold px-2.5 py-1 rounded-full bg-blue-600 text-white text-[10px]">Antrean Digital</span>
      </div>

      <form @submit.prevent="submitPermohonan('Umum')" class="space-y-5 rounded-3xl p-6 sm:p-8 border-2 shadow-sm" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black' : 'border-slate-200 bg-white'">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- NIK 16 Digit dengan Validasi -->
          <div class="space-y-1.5 sm:col-span-2">
            <label for="umum-nik" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Nomor Induk Kependudukan (NIK 16 Digit) *
            </label>
            <div class="relative">
              <input
                id="umum-nik"
                type="text"
                x-model="formUmum.nik"
                maxlength="16"
                required
                placeholder="Contoh: 320101XXXXXXXXXX"
                class="w-full px-4 py-3 rounded-2xl border-2 text-sm font-mono tracking-wider focus:outline-none focus:ring-4 transition-all"
                :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
              />
              <span class="absolute right-3.5 top-3.5 text-xs font-bold font-mono text-slate-400" x-text="formUmum.nik.length + '/16'"></span>
            </div>
            <p class="text-[11px] text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/70' : ''">Pastikan 16 digit sesuai e-KTP atau Kartu Keluarga resmi.</p>
          </div>

          <!-- Nama Lengkap -->
          <div class="space-y-1.5">
            <label for="umum-nama" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Nama Lengkap Pemohon *
            </label>
            <input
              id="umum-nama"
              type="text"
              x-model="formUmum.nama"
              required
              placeholder="Sesuai dokumen resmi"
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            />
          </div>

          <!-- No WhatsApp -->
          <div class="space-y-1.5">
            <label for="umum-wa" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Nomor WhatsApp / HP Aktif *
            </label>
            <input
              id="umum-wa"
              type="tel"
              x-model="formUmum.wa"
              required
              placeholder="08xxxxxxxxxx"
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            />
          </div>

          <!-- Picker Sesi Loket Kecamatan -->
          <div class="space-y-1.5">
            <label for="umum-sesi" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Pilihan Sesi Loket Kedatangan *
            </label>
            <select
              id="umum-sesi"
              x-model="formUmum.sesi"
              required
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm font-bold focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            >
              <option value="pagi">Sesi Pagi (08.00 - 11.30 WIB) - Kuota Tersedia</option>
              <option value="siang">Sesi Siang (13.00 - 15.30 WIB) - Kuota Tersedia</option>
            </select>
          </div>

          <!-- Pilihan Lokasi Kantor -->
          <div class="space-y-1.5">
            <label for="umum-kantor" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Lokasi Pengambilan Dokumen *
            </label>
            <select
              id="umum-kantor"
              x-model="formUmum.kantor"
              required
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm font-bold focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            >
              <option value="kecamatan">Loket Pelayanan Kantor Kecamatan Setempat</option>
              <option value="disdukcapil">Kantor Dinas Kependudukan & Pencatatan Sipil</option>
              <option value="kurir">Diantar ke Alamat Rumah via Pos Dinas</option>
            </select>
          </div>

          <!-- Alamat Lengkap -->
          <div class="space-y-1.5 sm:col-span-2">
            <label for="umum-alamat" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Alamat Domisili Lengkap *
            </label>
            <textarea
              id="umum-alamat"
              x-model="formUmum.alamat"
              rows="2"
              required
              placeholder="Nama Jalan, RT/RW, Kelurahan, Kecamatan"
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            ></textarea>
          </div>
        </div>

        <div class="pt-4 flex items-center justify-between gap-3 border-t" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40' : 'border-slate-200'">
          <div class="text-xs font-bold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
            ⏱️ Estimasi Waktu Antrean: ~10 Menit di Loket
          </div>
          <button
            type="submit"
            class="px-6 py-3.5 rounded-2xl font-black text-sm border-2 transition-all cursor-pointer shadow-md active:scale-95 flex items-center gap-2"
            :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300' : 'bg-blue-600 text-white border-blue-600 hover:bg-blue-700'"
          >
            <span>Kirim Pendaftaran Loket</span>
            <span aria-hidden="true">➔</span>
          </button>
        </div>
      </form>
    </div>

    <!-- ========================================== -->
    <!-- PENGALAMAN 2: TAMPILAN MODE LANSIA -->
    <!-- ========================================== -->
    <div
      x-show="activeMode === 'lansia'"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      class="space-y-6"
    >
      <!-- Banner Penjelasan Ramah Lansia -->
      <div
        class="p-5 rounded-3xl border-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
        :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-amber-300 bg-amber-50 text-amber-950'"
      >
        <div class="flex items-center gap-3">
          <span class="text-3xl">🚐</span>
          <div>
            <h2 class="text-lg font-black leading-tight">Layanan Prioritas Lansia — Petugas Datang ke Rumah</h2>
            <p class="text-xs font-bold mt-0.5" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : 'text-amber-800'">
              Bapak/Ibu usia 60 tahun ke atas tidak perlu datang ke kantor dinas. Tim armada kami yang akan berkunjung.
            </p>
          </div>
        </div>
        <button
          type="button"
          @click="bacaTeks('Mode Layanan Prioritas Lansia aktif. Petugas Dukcapil siap hadir langsung ke kediaman Bapak Ibu. Silakan isi nama, nomor kontak, dan alamat rumah.')"
          class="px-4 py-2 rounded-xl text-xs font-black border transition-all cursor-pointer shrink-0 flex items-center gap-1.5"
          :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-amber-400 text-slate-950 border-amber-500 hover:bg-amber-300'"
        >
          <span>🔊 Dengarkan Panduan</span>
        </button>
      </div>

      <!-- Formulir Teks Besar (Min 19px Font) & Layout Sederhana -->
