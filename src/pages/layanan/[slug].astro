---
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const services = [
    {
      slug: 'ktp',
      nama: 'KTP-el / Identitas Kependudukan',
      kategori: 'Identitas Pokok',
      ikon: '🪪',
      deskripsi: 'Perekaman pemula 17 tahun, penggantian fisik rusak/hilang, dan pembaruan biometrik',
      foto: 'https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Perekaman KTP baru pemula 17 tahun atau penggantian fisik hilang'
    },
    {
      slug: 'kk',
      nama: 'Kartu Keluarga (KK)',
      kategori: 'Data Keluarga',
      ikon: '👨‍👩‍👧',
      deskripsi: 'Pecah KK baru, penambahan anggota keluarga, dan perubahan biodata sipil',
      foto: 'https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Pemecahan KK karena pernikahan atau penambahan anggota keluarga baru'
    },
    {
      slug: 'kia',
      nama: 'KIA / Identitas Anak',
      kategori: 'Hak Sipil Anak',
      ikon: '👶',
      deskripsi: 'Penerbitan kartu identitas anak usia 0-17 tahun terintegrasi kutipan akta kelahiran',
      foto: 'https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Penerbitan KIA anak usia 5 tahun dan pencetakan kutipan akta kelahiran'
    },
    {
      slug: 'bpjs',
      nama: 'BPJS Kesehatan',
      kategori: 'Jaminan Kesehatan',
      ikon: '🏥',
      deskripsi: 'Sinkronisasi NIK kepesertaan PBI bantuan pemerintah dan pindah faskes tingkat 1',
      foto: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Pendaftaran peserta PBI bantuan pemerintah atau pindah puskesmas terdekat'
    },
    {
      slug: 'bansos',
      nama: 'Bantuan Sosial (Bansos)',
      kategori: 'Bantuan Sosial',
      ikon: '💰',
      deskripsi: 'Pengecekan desil kemiskinan DTKS, usulan sembako PKH, dan validasi dinas sosial',
      foto: 'https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Pengecekan status desil DTKS dan usulan bantuan sosial sembako PKH'
    },
    {
      slug: 'disabilitas',
      nama: 'Layanan Khusus Disabilitas',
      kategori: 'Akses Prioritas',
      ikon: '♿',
      deskripsi: 'Pendampingan sensorik netra/rungu, juru bahasa isyarat, dan jemput bola ke rumah',
      foto: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Permohonan pendampingan juru bahasa isyarat atau jemput bola kursi roda'
    },
    {
      slug: 'lansia',
      nama: 'Layanan Prioritas Lansia',
      kategori: 'Prioritas Usia 60+',
      ikon: '🧓',
      deskripsi: 'Percepatan rekam dokumen kependudukan dan armada keliling jemput bola ke kediaman',
      foto: 'https://images.unsplash.com/photo-1581579438747-1dc8d17bbce4?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Layanan rekam biometrik jemput bola ke rumah bagi warga lansia usia 75 tahun'
    },
    {
      slug: 'domisili',
      nama: 'Surat Pindah Domisili',
      kategori: 'Mobilitas Warga',
      ikon: '🏠',
      deskripsi: 'Penerbitan SKPWNI antar RT, kelurahan, kecamatan, dan lintas provinsi',
      foto: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Penerbitan SKPWNI pindah domisili dari Jakarta ke Depok'
    },
    {
      slug: 'akta',
      nama: 'Akta Lahir & Kematian',
      kategori: 'Catatan Sipil',
      ikon: '📄',
      deskripsi: 'Pencatatan dan penerbitan kutipan akta kelahiran baru maupun akta kematian',
      foto: 'https://images.unsplash.com/photo-1450133064473-71024230f91b?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Pencatatan akta kelahiran anak baru atau penerbitan akta kematian keluarga'
    },
    {
      slug: 'pendatang',
      nama: 'Panduan Warga Pindah',
      kategori: 'Integrasi Warga',
      ikon: '🗺️',
      deskripsi: 'Ceklist administrasi lapor RT/RW 1x24 jam dan pendaftaran domisili tempat tinggal',
      foto: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Ceklist administrasi lapor RT/RW 1x24 jam dan mutasi berkas kependudukan'
    },
    {
      slug: 'laporan',
      nama: 'Pengaduan & Laporan',
      kategori: 'Transparansi Publik',
      ikon: '📢',
      deskripsi: 'Saluran pengaduan pungli, kendala sidik jari biometrik, dan keluhan administrasi',
      foto: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Laporan kendala perekaman biometrik sidik jari di loket kecamatan'
    },
    // Aliases
    {
      slug: 'pindah',
      nama: 'Surat Pindah Domisili',
      kategori: 'Mobilitas Warga',
      ikon: '🏠',
      deskripsi: 'Penerbitan SKPWNI antar RT, kelurahan, dan provinsi',
      foto: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Penerbitan SKPWNI pindah domisili'
    },
    {
      slug: 'panduan',
      nama: 'Panduan Warga Pindah',
      kategori: 'Integrasi Warga',
      ikon: '🗺️',
      deskripsi: 'Ceklist administrasi lapor RT/RW 1x24 jam',
      foto: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Ceklist administrasi lapor RT/RW'
    },
    {
      slug: 'aduan',
      nama: 'Pengaduan & Laporan',
      kategori: 'Transparansi Publik',
      ikon: '📢',
      deskripsi: 'Saluran pengaduan pungli dan kendala layanan',
      foto: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=800&q=80',
      contohKeperluan: 'Laporan kendala administrasi'
    }
  ];

  return services.map((s) => ({
    params: { slug: s.slug },
    props: { service: s }
  }));
}

const { service } = Astro.props;
---

<MainLayout
  title={`${service.nama} — KITA-TERPADU`}
  description={`Pengajuan formulir adaptif ${service.nama} dengan opsi umum, lansia jemput bola, dan disabilitas.`}
>
  <div
    class="max-w-5xl mx-auto px-4 sm:px-6 py-6 space-y-6 sm:space-y-8 w-full max-w-full overflow-x-hidden"
    x-data={`formAdaptive3in1('${service.nama}', '${service.slug}')`}
  >
    <!-- BREADCRUMB & HEADER -->
    <div class="space-y-3">
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs font-bold text-slate-500 truncate" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
        <a href="/" class="hover:underline">Beranda</a>
        <span>/</span>
        <span class="text-blue-600 font-extrabold truncate" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : ''">{service.kategori}</span>
        <span>/</span>
        <span class="text-slate-800 truncate" :class="temaDisabilitas === 'netra-kontras' ? 'text-white' : ''">{service.nama}</span>
      </nav>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40' : 'border-slate-200'">
        <div class="flex items-center gap-3">
          <span class="w-12 h-12 rounded-2xl flex items-center justify-center text-2xl border shadow-xs shrink-0" :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-blue-50 text-blue-900 border-blue-200'">
            {service.ikon}
          </span>
          <div>
            <h1 class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'">
              {service.nama}
            </h1>
            <p class="text-xs sm:text-sm font-semibold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
              {service.deskripsi}
            </p>
          </div>
        </div>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black border self-start sm:self-auto" :class="temaDisabilitas === 'netra-kontras' ? 'bg-black text-[#FACC15] border-[#FACC15]' : 'bg-emerald-50 text-emerald-800 border-emerald-200'">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>100% Bebas Biaya</span>
        </span>
      </div>
    </div>

    <!-- SWITCHER 3 MODE RESPONSIF (Grid 1 kolom di HP, 3 kolom di desktop) -->
    <div class="w-full">
      <div
        class="grid grid-cols-1 sm:grid-cols-3 gap-2 w-full max-w-xl mx-auto p-1.5 rounded-2xl border-2 backdrop-blur-md shadow-sm"
        :class="temaDisabilitas === 'netra-kontras' ? 'bg-black border-[#FACC15]' : 'bg-white border-slate-200'"
        role="tablist"
        aria-label="Pilihan 3 Mode Pelayanan"
      >
        <button
          type="button"
          @click="gantiMode('umum')"
          class="w-full py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer flex items-center justify-center gap-2"
          :class="activeMode === 'umum'
            ? (temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black shadow-sm font-black' : 'bg-slate-900 text-white shadow-md')
            : (temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15] hover:bg-neutral-900' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100')"
          role="tab"
          :aria-selected="(activeMode === 'umum').toString()"
        >
          <span>👤</span>
          <span>Mode Umum</span>
        </button>

        <button
          type="button"
          @click="gantiMode('lansia')"
          class="w-full py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer flex items-center justify-center gap-2"
          :class="activeMode === 'lansia'
            ? (temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black shadow-sm font-black' : 'bg-amber-500 text-slate-950 shadow-md ring-2 ring-amber-300')
            : (temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15] hover:bg-neutral-900' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100')"
          role="tab"
          :aria-selected="(activeMode === 'lansia').toString()"
        >
          <span>🧓</span>
          <span>Mode Lansia</span>
        </button>

        <button
          type="button"
          @click="gantiMode('disabilitas')"
          class="w-full py-2.5 px-3 rounded-xl text-xs sm:text-sm font-black transition-all cursor-pointer flex items-center justify-center gap-2"
          :class="activeMode === 'disabilitas'
            ? (temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black shadow-sm font-black' : 'bg-purple-600 text-white shadow-md ring-2 ring-purple-300')
            : (temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15] hover:bg-neutral-900' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100')"
          role="tab"
          :aria-selected="(activeMode === 'disabilitas').toString()"
        >
          <span>♿</span>
          <span>Mode Disabilitas</span>
        </button>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- AREA A: MODE UMUM (Form Mandiri Antrean Loket) -->
    <!-- ============================================== -->
    <div
      x-show="activeMode === 'umum'"
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0 translate-y-1"
      x-transition:enter-end="opacity-100 translate-y-0"
      class="space-y-5"
    >
      <div class="p-3.5 rounded-2xl border flex items-center justify-between gap-2 text-xs" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-blue-200 bg-blue-50 text-blue-900'">
        <div class="flex items-center gap-2">
          <span class="text-base">🏢</span>
          <span class="font-bold">Formulir Mandiri Loket Kecamatan & Pengantaran Dokumen</span>
        </div>
        <span class="font-black px-2 py-0.5 rounded-full bg-blue-600 text-white text-[10px]">Antrean Mandiri</span>
      </div>

      <form @submit.prevent="submitPermohonan('Umum')" class="space-y-4 rounded-3xl p-5 sm:p-7 border-2 shadow-sm" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black' : 'border-slate-200 bg-white'">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5 sm:col-span-2">
            <label for="u-nik" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              NIK Pemohon (16 Digit) *
            </label>
            <div class="relative">
              <input
                id="u-nik"
                type="text"
                x-model="formUmum.nik"
                maxlength="16"
                required
                placeholder="320101XXXXXXXXXX"
                class="w-full px-4 py-3 rounded-2xl border-2 text-sm font-mono tracking-wider focus:outline-none focus:ring-4 transition-all"
                :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
              />
              <span class="absolute right-3.5 top-3.5 text-xs font-bold font-mono text-slate-400" x-text="formUmum.nik.length + '/16'"></span>
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="u-nama" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Nama Lengkap *
            </label>
            <input
              id="u-nama"
              type="text"
              x-model="formUmum.nama"
              required
              placeholder="Nama sesuai KTP/KK"
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            />
          </div>

          <div class="space-y-1.5">
            <label for="u-wa" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Nomor WhatsApp / HP *
            </label>
            <input
              id="u-wa"
              type="tel"
              x-model="formUmum.wa"
              required
              placeholder="08xxxxxxxxxx"
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            />
          </div>

          <div class="space-y-1.5">
            <label for="u-sesi" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Pilihan Sesi Loket *
            </label>
            <select
              id="u-sesi"
              x-model="formUmum.sesi"
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm font-bold focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            >
              <option value="pagi">Sesi Pagi (08.00 - 11.30 WIB)</option>
              <option value="siang">Sesi Siang (13.00 - 15.30 WIB)</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="u-kantor" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Lokasi Pengambilan Dokumen *
            </label>
            <select
              id="u-kantor"
              x-model="formUmum.kantor"
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm font-bold focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            >
              <option value="kecamatan">Loket Kantor Kecamatan</option>
              <option value="disdukcapil">Kantor Dinas Dukcapil</option>
              <option value="kurir">Diantar ke Rumah via Pos Dinas</option>
            </select>
          </div>

          <div class="space-y-1.5 sm:col-span-2">
            <label for="u-alamat" class="block text-xs font-black uppercase tracking-wider" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-700'">
              Alamat Domisili Lengkap *
            </label>
            <textarea
              id="u-alamat"
              x-model="formUmum.alamat"
              rows="2"
              required
              placeholder="Nama Jalan, RT/RW, Kelurahan, Kecamatan"
              class="w-full px-4 py-3 rounded-2xl border-2 text-sm focus:outline-none focus:ring-4 transition-all"
              :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15] focus:ring-white' : 'border-slate-300 focus:border-blue-600 focus:ring-blue-200'"
            ></textarea>
          </div>
        </div>

        <div class="pt-3 flex flex-col sm:flex-row items-center justify-between gap-3 border-t" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15]/40' : 'border-slate-200'">
          <span class="text-xs font-bold text-slate-500" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : ''">
            ⏱️ Estimasi Waktu Antrean: ~10 Menit
          </span>
          <button
            type="submit"
            class="w-full sm:w-auto px-6 py-3 rounded-2xl font-black text-sm border-2 transition-all cursor-pointer shadow-sm active:scale-95 flex items-center justify-center gap-2"
            :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15] hover:bg-yellow-300' : 'bg-blue-600 text-white border-blue-600 hover:bg-blue-700'"
          >
            <span>Kirim Pendaftaran Loket</span>
            <span aria-hidden="true">➔</span>
          </button>
        </div>
      </form>
    </div>

    <!-- ============================================== -->
    <!-- AREA B: MODE LANSIA (Teks Besar & Jemput Bola) -->
    <!-- ============================================== -->
    <div
      x-show="activeMode === 'lansia'"
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0 translate-y-1"
      x-transition:enter-end="opacity-100 translate-y-0"
      class="space-y-5"
    >
      <div
        class="p-4 sm:p-5 rounded-3xl border-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
        :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black text-[#FACC15]' : 'border-amber-300 bg-amber-50 text-amber-950'"
      >
        <div class="flex items-center gap-3">
          <span class="text-3xl shrink-0">🚐</span>
          <div>
            <h2 class="text-base sm:text-lg font-black leading-tight">Layanan Prioritas Lansia — Petugas Datang ke Rumah</h2>
            <p class="text-xs font-bold mt-0.5" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]/80' : 'text-amber-800'">
              Warga usia 60 tahun ke atas tidak perlu antre. Tim petugas akan datang membawa alat perekaman biometrik.
            </p>
          </div>
        </div>

        <button
          type="button"
          @click="bacaPanduan('Mode Lansia aktif. Petugas Dukcapil siap datang ke rumah Bapak Ibu untuk perekaman data. Silakan isi nama, kontak keluarga, dan alamat rumah.')"
          class="px-4 py-2 rounded-xl text-xs font-black border transition-all cursor-pointer shrink-0 flex items-center gap-1.5 self-start sm:self-auto"
          :class="temaDisabilitas === 'netra-kontras' ? 'bg-[#FACC15] text-black border-[#FACC15]' : 'bg-amber-400 text-slate-950 border-amber-500 hover:bg-amber-300'"
        >
          <span>🔊 Dengar Suara</span>
        </button>
      </div>

      <form @submit.prevent="submitPermohonan('Lansia')" class="space-y-5 rounded-3xl p-5 sm:p-8 border-2 shadow-sm text-base sm:text-lg" :class="temaDisabilitas === 'netra-kontras' ? 'border-[#FACC15] bg-black' : 'border-amber-200 bg-white'">
        <div class="space-y-4">
          <div class="space-y-1.5">
            <label for="l-nama" class="block font-black text-sm sm:text-base" :class="temaDisabilitas === 'netra-kontras' ? 'text-[#FACC15]' : 'text-slate-900'">
              1. Nama Lengkap Bapak / Ibu:
            </label>
            <input
              id="l-nama"
              type="text"
              x-model="formLansia.nama"
              required
              placeholder="Contoh: Bapak H. Soepardi"
