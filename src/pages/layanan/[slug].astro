  <!-- SCRIPT ALPINE CONTROLLER UNTUK 3 MODE LAYANAN -->
  <script is:inline>
    function formAdaptiveEngine(namaLayanan, slugLayanan) {
      return {
        namaLayanan: namaLayanan,
        slugLayanan: slugLayanan,
        activeMode: 'umum',
        showSuccessModal: false,
        submittedRecord: {},

        formUmum: {
          nik: '',
          nama: '',
          wa: '',
          sesi: 'pagi',
          kantor: 'kecamatan',
          alamat: ''
        },

        formLansia: {
          nama: '',
          nik: '',
          wa: '',
          alamat: '',
          tirahBaring: false
        },

        formDisabilitas: {
          fasilitas: ['jemput'],
          nama: '',
          nik: '',
          wa: '',
          alamat: ''
        },

        init() {
          // Pre-select mode if slug is lansia or disabilitas
          if (this.slugLayanan === 'lansia') {
            this.activeMode = 'lansia';
          } else if (this.slugLayanan === 'disabilitas') {
            this.activeMode = 'disabilitas';
          }
        },

        pilihMode(mode) {
          this.activeMode = mode;
          if (window.enterpriseA11yData) {
            // trigger click sound
          }
          try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.frequency.setValueAtTime(mode === 'lansia' ? 700 : (mode === 'disabilitas' ? 850 : 600), ctx.currentTime);
            gain.gain.setValueAtTime(0.08, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.05);
          } catch (e) {}
        },

        submitPermohonan(kategori) {
          const now = new Date();
          const yyyy = now.getFullYear();
          const mm = String(now.getMonth() + 1).padStart(2, '0');
          const dd = String(now.getDate()).padStart(2, '0');
          const random4 = Math.floor(1000 + Math.random() * 9000);
          const regNumber = `KITA-KTP-${yyyy}${mm}${dd}-${random4}`;

          let dataPayload = {
            id: regNumber,
            regNumber: regNumber,
            layanan: this.namaLayanan,
            kategori: kategori,
            tanggal: `${dd} September ${yyyy}`,
            step: 1,
            statusTitle: 'Permohonan Diterima & Terverifikasi Sistem',
            statusMessage: 'Nomor registrasi telah diterbitkan. Berkas sedang dalam tahap pra-verifikasi kelengkapan dokumen.',
            estimasi: kategori === 'Lansia' || kategori === 'Disabilitas' ? '1-2 Hari Kerja (Jemput Bola)' : '1 Hari Kerja'
          };

          if (kategori === 'Umum') {
            dataPayload.nik = this.formUmum.nik;
            dataPayload.nama = this.formUmum.nama;
            dataPayload.wa = this.formUmum.wa;
            dataPayload.alamat = this.formUmum.alamat;
            dataPayload.catatan = `Sesi: ${this.formUmum.sesi} - Pengambilan: ${this.formUmum.kantor}`;
          } else if (kategori === 'Lansia') {
            dataPayload.nik = this.formLansia.nik;
            dataPayload.nama = this.formLansia.nama;
            dataPayload.wa = this.formLansia.wa;
            dataPayload.alamat = this.formLansia.alamat;
            dataPayload.catatan = this.formLansia.tirahBaring ? 'Prioritas Lansia Tirah Baring (Armada ke Rumah)' : 'Prioritas Lansia Mandiri';
          } else if (kategori === 'Disabilitas') {
            dataPayload.nik = this.formDisabilitas.nik;
            dataPayload.nama = this.formDisabilitas.nama;
            dataPayload.wa = this.formDisabilitas.wa;
            dataPayload.alamat = this.formDisabilitas.alamat;
            dataPayload.catatan = `Fasilitas: ${this.formDisabilitas.fasilitas.join(', ')}`;
          }

          // Save to localStorage
          const KEY = 'semua_pengajuan_layanan';
          const KEY_OLD = 'kita_ktp_records';
          let records = [];
          try {
            const raw = localStorage.getItem(KEY);
            if (raw) records = JSON.parse(raw);
          } catch (e) {}

          records.unshift(dataPayload);
          localStorage.setItem(KEY, JSON.stringify(records));
          localStorage.setItem(KEY_OLD, JSON.stringify(records));

          this.submittedRecord = dataPayload;
          this.showSuccessModal = true;

          // Sound effect
          try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
              const osc = ctx.createOscillator();
              const gain = ctx.createGain();
              osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.08);
              gain.gain.setValueAtTime(0.1, ctx.currentTime + idx * 0.08);
              gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + idx * 0.08 + 0.25);
              osc.connect(gain);
              gain.connect(ctx.destination);
              osc.start(ctx.currentTime + idx * 0.08);
              osc.stop(ctx.currentTime + idx * 0.08 + 0.25);
            });
          } catch (e) {}

          // Speech Announcement
          if ('speechSynthesis' in window) {
            const utterance = new SpeechSynthesisUtterance(`Permohonan ${this.namaLayanan} berhasil diajukan dengan nomor registrasi ${regNumber}.`);
            utterance.lang = 'id-ID';
            window.speechSynthesis.speak(utterance);
          }
        }
      };
    }
  </script>
</MainLayout>
